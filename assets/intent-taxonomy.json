{
  "version": 1,
  "domain": "hsms_scriptorium",
  "lifecycle": [
    "INGEST",
    "VALIDATE",
    "EDIT",
    "ANALYZE",
    "EXPORT",
    "LIBRARY"
  ],
  "slot_legend": {
    "word": {
      "type": "string",
      "description": "Surface form / lemma needle"
    },
    "folio_id": {
      "type": "string",
      "description": "Leaf id e.g. 1r, 12v"
    },
    "range": {
      "type": "folioRange",
      "description": "Inclusive folio span"
    },
    "window": {
      "type": "int",
      "unit": "tokens",
      "default": 5
    },
    "n": {
      "type": "int",
      "description": "N-gram order",
      "default": 3
    },
    "top": {
      "type": "int",
      "description": "Rank list size",
      "default": 10
    },
    "lang": {
      "type": "hsmsLang",
      "description": "HSMS language mnemonic LAT/ARB/…"
    },
    "hand": {
      "type": "int",
      "description": "Secondary hand index"
    }
  },
  "barriers": {
    "EMPTY_COLUMN_ENVELOPE": {
      "stage": "VALIDATE",
      "severity": "Column tag {CBn.} has no body before closing }",
      "blocks": [
        "EXPORT_TEI",
        "EXPORT_HTML"
      ]
    },
    "MISSING_FOLIO_MARKER": {
      "stage": "VALIDATE",
      "severity": "No [fol. …] marker in the witness",
      "blocks": [
        "JUMP_FOLIO"
      ]
    },
    "UNREVIEWED_SIDECAR": {
      "stage": "INGEST",
      "severity": "Machine-transcribed folio sides still unreviewed",
      "blocks": [
        "MARK_REVIEWED"
      ]
    },
    "LOW_CONFIDENCE_LINES": {
      "stage": "INGEST",
      "severity": "Recognition confidence below threshold",
      "blocks": [
        "PASS_TWO_REPAIR"
      ]
    }
  },
  "intents": {
    "ingest:sidecar:review_progress": {
      "recipeId": "ingest.unreviewed",
      "stage": "INGEST",
      "doActions": [
        "OPEN_INGEST_PANEL",
        "JUMP_FOLIO"
      ],
      "slots": [],
      "examples": [
        "folios still unreviewed",
        "review progress for machine transcription",
        "which folio sides need human review"
      ]
    },
    "ingest:sidecar:low_confidence": {
      "recipeId": "ingest.low_confidence",
      "stage": "INGEST",
      "doActions": [
