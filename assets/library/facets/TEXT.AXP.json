{"format":"hsms-facets/1","baseName":"TEXT.AXP","witnessHash":"1:ms_rlskb7","wordCount":52039,"typeCount":7521,"ttr":0.1445262207190761,"sttr":0.47774999999999995,"hapax":4256,"facets":{"rubrics":[{"folioId":"1r","text":"Capitulo primero como el patriar"},{"folioId":"1r","text":"cha Jacob añuncio/ si quier hablando a sus hijos en"},{"folioId":"1r","text":"el passo dela muerte: prophetizo el anticristo venidero."},{"folioId":"2v","text":"Capitulo segundo como el padre del"},{"folioId":"2v","text":"anticristo ha de requerir su misma"},{"folioId":"2v","text":"hija del pecado dela carne: y dende"},{"folioId":"2v","text":"ha de nascer el anticristo"},{"folioId":"3v","text":"Capitulo .iij. como el padre del anti"},{"folioId":"3v","text":"cristo haura parte con su misma hija: y ende sera concebi"},{"folioId":"3v","text":"do en tan abominable peccado este principe tan maldito"},{"folioId":"4v","text":"Capitulo .iiij. como el anticristo ha"},{"folioId":"4v","text":"de nascer en Babilonia: y sera criado enlas ciudades"},{"folioId":"4v","text":"de Corozaim y Bethsayda"},{"folioId":"6r","text":"Capitulo .u. como el Anticristo des"},{"folioId":"6r","text":"cendera en Jherusalem/ y ende se hara circuncidar/"},{"folioId":"6r","text":"siendo rescebido por los judios."},{"folioId":"7v","text":"Capitulo .vj. como el anticristo atentara ⇒"},{"folioId":"8r","text":"de mudar las leyes y cuenta delos tiempos. y sera"},{"folioId":"8r","text":"muy embuelto enel peccado dela carne con ypocresia"},{"folioId":"9v","text":"Capitulo septimo como los judios"},{"folioId":"9v","text":"han de reparar/ o rehedificar el templo en Jherusa"},{"folioId":"9v","text":"lem: el qual fue destruydo por los romanos."},{"folioId":"10v","text":"Capitulo .viij. como el Anticristo"},{"folioId":"10v","text":"ha de hazer alquimia: y engañara los grandes conel"},{"folioId":"10v","text":"dinero de aquella."},{"folioId":"12r","text":"Capitulo .ix. como el antichristo sus"},{"folioId":"12r","text":"citara los muertos con arte diabolica: y sera todo fal"},{"folioId":"12r","text":"so lleno de engaño."},{"folioId":"13r","text":"Capitulo .x. como han de venir He"},{"folioId":"13r","text":"lias y Enoch a predicar la ley de cristo nuestro redem"},{"folioId":"13r","text":"ptor: para confirmar los cristianos ante que se demuestre"},{"folioId":"13r","text":"el Anticristo."},{"folioId":"14v","text":"Capitulo .xj. como helias propheta"},{"folioId":"14v","text":"vestido de marregas predicara la fe del redemptor:"},{"folioId":"14v","text":"y dara esfuerço alos cristianos."},{"folioId":"15v","text":"Capitulo .xij. como Enoch prophe"},{"folioId":"15v","text":"ta demuestra el anticristo venidero ser falso/ y hecho"},{"folioId":"15v","text":"en adulterio: esforça los christianos confirmando los"},{"folioId":"15v","text":"enla fe."},{"folioId":"16v","text":"Capitulo .xiij. como el Antichristo"},{"folioId":"16v","text":"mandara quemar los libros dela ley/ por ensalçar su"},{"folioId":"16v","text":"mala secta."},{"folioId":"18r","text":"Capitulo .xiiij. como el mismo anti"},{"folioId":"18r","text":"cristo predicara su mala secta: contradiziendo ala ley"},{"folioId":"18r","text":"de cristo."},{"folioId":"19r","text":"Capitulo .xv. dela segunda persecu"},{"folioId":"19r","text":"cion del anticristo como hara turbar los mares y co"},{"folioId":"19r","text":"mouer los vientos."}],"glosses":[],"dropInitials":[{"folioId":"1r","text":"D","letter":"D","depth":8},{"folioId":"3r","text":"P","letter":"P","depth":4},{"folioId":"3v","text":"C","letter":"C","depth":4},{"folioId":"5r","text":"D","letter":"D","depth":4},{"folioId":"6r","text":"P","letter":"P","depth":4},{"folioId":"8r","text":"E","letter":"E","depth":4},{"folioId":"9v","text":"L","letter":"L","depth":4},{"folioId":"10v","text":"D","letter":"D","depth":4},{"folioId":"12r","text":"H","letter":"H","depth":4},{"folioId":"13v","text":"E","letter":"E","depth":4},{"folioId":"15r","text":"H","letter":"H","depth":4},{"folioId":"15v","text":"E","letter":"E","