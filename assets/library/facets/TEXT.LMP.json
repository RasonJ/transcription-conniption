itulo .u. de armenia menor"},{"folioId":"7r","text":"& de muchas cosas que alli se fazen."},{"folioId":"7r","text":"¶ Capitulo .vj. delos turchoma"},{"folioId":"7r","text":"nos en armenia menor."},{"folioId":"7r","text":"¶ Capitulo .vij. de armenia"},{"folioId":"7r","text":"mayor y del arca de Noe."},{"folioId":"7r","text":"¶ Capitulo .viij. de Georgea"},{"folioId":"7r","text":"nia y de Puertas de fierro."},{"folioId":"7v","text":"¶ Capitulo .xix. delas partes de arme"},{"folioId":"7v","text":"nia que estan fazia medio dia y del reyno mosul."},{"folioId":"7v","text":"¶ Capitulo .x. de Baldach y de mu"},{"folioId":"7v","text":"chas nobles cosas que ay enella."},{"folioId":"8r","text":"¶ Capitulo .xj. Dela cibdad"},{"folioId":"8r","text":"Totis: & otras buenas cosas."},{"folioId":"8r","text":"¶ Capitulo .xij. de vn gran mi"},{"folioId":"8r","text":"lagro que acaecio en Mosul."}],"glosses":[],"dropInitials":[{"folioId":"1v","text":"E","letter":"E","depth":6},{"folioId":"2r","text":"P","letter":"P","depth":4},{"folioId":"2v","text":"L","letter":"L","depth":4},{"folioId":"6r","text":"M","letter":"M","depth":4},{"folioId":"6v","text":"A","letter":"A","depth":4},{"folioId":"6v","text":"A","letter":"A","depth":4},{"folioId":"6v","text":"D","letter":"D","depth":4},{"folioId":"7r","text":"P","letter":"P","depth":4},{"folioId":"7r","text":"Y","letter":"Y","depth":4},{"folioId":"7r","text":"A","letter":"A","depth":4},{"folioId":"7r","text":"E","letter":"E","depth":4},{"folioId":"7v","text":"B","letter":"B","depth":4},{"folioId":"8r","text":"T","letter":"T","depth":4},{"folioId":"8r","text":"E","letter":"E","depth":4},{"folioId":"8v","text":"P","letter":"P","depth":4},{"folioId":"9r","text":"E","letter":"E","depth":4},{"folioId":"9r","text":"J","letter":"J","depth":4},{"folioId":"9v","text":"C","letter":"C","depth":4},{"folioId":"9v","text":"D","letter":"D","depth":4},{"folioId":"10r","text":"P","letter":"P","depth":4},{"folioId":"10r","text":"A","letter":"A","depth":4},{"folioI