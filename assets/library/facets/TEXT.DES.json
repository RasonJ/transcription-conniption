{"format":"hsms-facets/1","baseName":"TEXT.DES","witnessHash":"1:ms_f1lzys","wordCount":30492,"typeCount":4825,"ttr":0.1582382264200446,"sttr":0.4090333333333333,"hapax":2802,"facets":{"rubrics":[{"folioId":"333r","text":"DESPERTADOR, QVE"},{"folioId":"333r","text":"TRATA DE LA GRAN FERTI"},{"folioId":"333r","text":"lidad, riquezas, baratos, armas, y cauallos"},{"folioId":"333r","text":"que España solia tener, y la causa de"},{"folioId":"333r","text":"los daños y falta, con el reme"},{"folioId":"333r","text":"dio suficiente."},{"folioId":"333r","text":"DIALOGO PRIMERO, EN QVE"},{"folioId":"333r","text":"se trata de la gran fertilidad y barato de bastimentos"},{"folioId":"333r","text":"de España, y sus grandes riquezas de oro, plata, pie"},{"folioId":"333r","text":"dras, sedas y brocados que tvo, y las muchas ar"},{"folioId":"333r","text":"mas, cauallos, y exercitos que sustentò duran"},{"folioId":"333r","text":"te seyscientos años de guerras con"},{"folioId":"333r","text":"tinuas, sin traer bastimento"},{"folioId":"333r","text":"de fuera."},{"folioId":"333r","text":"Interlocutores"},{"folioId":"333r","text":"Iustino y Camileto."},{"folioId":"345r","text":"DIALOGO SEGVNDO,"},{"folioId":"345r","text":"EN QUE SE TRATA LA CAVSA DE"},{"folioId":"345r","text":"la carestia, y falta de manten im ientos, y caua"},{"folioId":"345r","text":"llos, y otras cosas: y se pone remedio para que to"},{"folioId":"345r","text":"do buelua a lo que solia, y los bastimen"},{"folioId":"345r","text":"tos à los passados."},{"folioId":"345r","text":"Interlocutores"},{"folioId":"345r","text":"Iustino y Camileto."},{"folioId":"354r","text":"Tanteo de gastos que han hecho y causado vn par de machos"},{"folioId":"354r","text":"o mulos antes que siruan, que son de tres para quatro años."},{"folioId":"354v","text":"Tanteo de vn par de mulas de labor."},{"folioId":"355r","text":"Tanteo de vn par de bueyes de labor."},{"folioId":"355v","text":"Tanteo mayor de bueyes en vn lugar llamado, Discrecion,"},{"folioId":"355v","text":"Fertilidad, Abundancia, Riqueza y poder para guerra."},{"folioId":"356v","text":"Tanteo mayor de mulas, en vn lugar llamado Inhabilidad,"},{"folioId":"356v","text":"Pobreza y Flaqueza."},{"folioId":"359r","text":"Tanteo de machos de harrieros"},{"folioId":"359v","text":"Tanteo de bueyes de carreteria"},{"folioId":"361v","text":"DIALOGO TERCERO"},{"folioId":"361v","text":"EN QVE SE TRATA Y PONE LA OR"},{"folioId":"361v","text":"den que se ha de tener en cultiuar, arar, estercolar, y sem"},{"folioId":"361v","text":"brar las tierras, y el gran prouecho que se sigue"},{"folioId":"361v","text":"de arar, cauar hondo las tierras, viñas, y oli"},{"folioId":"361v","text":"uares, como solian, y en que tiempo se ha"},{"folioId":"361v","text":"de hazer cada cosa."},{"folioId":"361v","text":"Interlocutores"},{"folioId":"361v","text":"Camileto y Iustino."},{"folioId":"368v","text":"Laus Deo."}],"glosses":[],"dropInitials":[{"folioId":"333r","text":"I","letter":"I","depth":4},{"folioId":"345r","text":"I","letter":"I","depth":4},{"folioId":"354r","text":"E","letter":"E","depth":2},{"folioId":"355v","text":"L","letter":"L","depth":2},{"folioId":"356v","text":"E","letter":"E","depth":2},{"folioId":"359r","text":"I","letter":"I","depth":2},{"folioId":"361v","text":"C","letter":"C","depth":3}],"codeSwitching":[{"lang":"LAT","words":268,"tokens":569,"spans":38}],"hands":[],"blockCounts":{"rubric":44,"prose":2674,"language_span":38},"tokenCounts":{"text":66535,"hyphen":1003,"expansion":880,"drop_initial":7,"blank_space":38,"editorial_deletion":56,"editorial_insertion":50,"reconstructed_text":7}},"termFreq":{"que":1172,"los":514,"las":449,"por":313,"con":289,"como":256,"para":228,"mas":187,"otras":162,"bueyes":143,"del":139,"tierra":121,"espana":118,"mil":114,"todo":113,"muy":109,"iustino":107,"cada":105,"son":102,"dos":99,"porque":99,"mulas":97,"vna":96,"assi":94,"camileto":89,"otros":89,"cosas":83,"rey":82,"oro":81,"sus":81,"tan":78,"ano":75,"cauallos":74,"esta