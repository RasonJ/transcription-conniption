{"format":"hsms-facets/1","baseName":"TEXT.SIH","witnessHash":"1:ms_10u65yk","wordCount":15807,"typeCount":3853,"ttr":0.24375276776111848,"sttr":0.4832000000000001,"hapax":2496,"facets":{"rubrics":[{"folioId":"1r","text":"Esta es la yliada de home"},{"folioId":"1r","text":"ro en romance. Traduzida por"},{"folioId":"1r","text":"Juan de mena."},{"folioId":"1v","text":"¶ Jllustre y muy"},{"folioId":"1v","text":"magnifico señor."},{"folioId":"2v","text":"¶ Comiença la yliada de homero: tra"},{"folioId":"2v","text":"duzida en lengua vulgar por el famoso poeta castellano"},{"folioId":"2v","text":"Juan de mena."},{"folioId":"2v","text":"¶ Prohemio de Juan de mena"},{"folioId":"2v","text":"al rey don Juan el segundo."},{"folioId":"6v","text":"¶ Capitulo primero enel"},{"folioId":"6v","text":"qual Homero exclama la sentencia/ &"},{"folioId":"6v","text":"assigna en summa la causa dela gran pe"},{"folioId":"6v","text":"stilencia."},{"folioId":"7r","text":"¶ Capitulo .ij. com o el sacerdote Crisis rue"},{"folioId":"7r","text":"ga con dones a Agamenon que le buelua su"},{"folioId":"7r","text":"hija/ y como Agamemon menosprecia los do"},{"folioId":"7r","text":"nes y palabras y le manda yr sin la hija."},{"folioId":"7v","text":"¶ Capitulo. iij. Como haze Crisis gran llan"},{"folioId":"7v","text":"to enel templo de phebo por su hija que no le"},{"folioId":"7v","text":"bueluen: y como se querella a phebo."},{"folioId":"8r","text":"¶ Capitulo. iiij. Como ouo gran pestilencia"},{"folioId":"8r","text":"enel real delos griegos: & como Colcas supo"},{"folioId":"8r","text":"delos dioses que esta pestilencia venia por la"},{"folioId":"8r","text":"hija de Crisis que tenia Agamenon forçada"},{"folioId":"8r","text":"& como los griegos forçaron a Agamenon que la"},{"folioId":"8r","text":"embiase al su padre: & como fue lleuada por"},{"folioId":"8r","text":"vlixes."},{"folioId":"8v","text":"¶ Capitulo. u. Como cesso la pestilencia des"},{"folioId":"8v","text":"pues que Crisida fue a su padre restituyda: &"},{"folioId":"8v","text":"como agamenon y achiles ouieron question."},{"folioId":"9v","text":"¶ Capitulo. vj. Como jupiter embio de no"},{"folioId":"9v","text":"che al dios del sueño a Agamenon con men"},{"folioId":"9v","text":"saje que se aparejasse para dar batalla alos"},{"folioId":"9v","text":"troyanos."},{"folioId":"10r","text":"¶ Capitulo. vij. Como todos los capitanes"},{"folioId":"10r","text":"delos griegos se offrescieron a Agamenon pa"},{"folioId":"10r","text":"ra la batalla/ & como tersides dezia que no le"},{"folioId":"10r","text":"diesse & fizieron el consejo de nestor."},{"folioId":"10v","text":"¶ Capitulo .viij. dela exclamacion que"},{"folioId":"10v","text":"haze Homero alas musas."},{"folioId":"11r","text":"¶ Capitulo .ix. delos principes que vinieron"},{"folioId":"11r","text":"sobre troya: & las fustas que traxeron."},{"folioId":"12r","text":"¶ Capitulo .x. Delos principes y capitanes"},{"folioId":"12r","text":"que auia en Troya para defenderla."},{"folioId":"12v","text":"Capitulo .xj. De como Paris huyo"},{"folioId":"12v","text":"de Menelao: & como Hetor le reprehen"},{"folioId":"12v","text":"de por ello: y Paris se escusa."}],"glosses":[],"dropInitials":[{"folioId":"7r","text":"C","letter":"C","depth":4},{"folioId":"8v","text":"L","letter":"L","depth":4},{"folioId":"9v","text":"L","letter":"L","depth":4},{"folioId":"10r","text":"E","letter":"E","depth":4},{"folioId":"10v","text":"O","letter":"O","depth":4},{"folioId":"11r","text":"U","letter":"U","depth":4},{"folioId":"12r","text":"Y","letter":"Y","depth":4},{"folioId":"12v","text":"Y","letter":"Y","depth":4},{"folioId":"13r","text":"L","letter":"L","depth":4},{"folioId":"14r","text":"D","letter":"D","depth":4},{"folioId":"14v","text":"E","letter":"E","depth":4},{"folioId":"15v","text":"D","letter":"D","depth":4},{"folioId":"16v","text":"D","letter":"D","depth":4},{"folioId":"18r","text":"A","letter":"A","depth":4},{"folioId":"19v","text":"E","letter":"E","depth":4},{"folioId":"20v","