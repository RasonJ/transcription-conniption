{"format":"hsms-facets/1","baseName":"TEXT.AMA","witnessHash":"1:ms_i8gyyc","wordCount":451340,"typeCount":14577,"ttr":0.03229715956928258,"sttr":0.4222128603104215,"hapax":5956,"facets":{"rubrics":[{"folioId":"1r","text":"Amadis de gaula."},{"folioId":"1r","text":"Los quatro libros de Ama"},{"folioId":"1r","text":"dis de gaula nueuamen"},{"folioId":"1r","text":"te impressos & hystoria"},{"folioId":"1r","text":"dos en Seuilla."},{"folioId":"2v","text":"¶ Aqui comiença el primero libro del esforçado & virtuo"},{"folioId":"2v","text":"so cauallero Amadis hijo del rey Perion de Gaula / y dela reyna Elisena: el qual fue corregi"},{"folioId":"2v","text":"do y emendado por el honrado & virtuoso cauallero Garciordoñes de Montaluo: regidor de"},{"folioId":"2v","text":"la noble villa de Medina del campo: & corrigiole delos antiguos originales que estauan cor"},{"folioId":"2v","text":"ruptos & mal compuestos en antiguo estilo: por falta delos diferentes y malos escriptores. Qui"},{"folioId":"2v","text":"tando muchas palabras superfluas / & poniendo otras de mas polido y elegante estilo: tocantes"},{"folioId":"2v","text":"ala caualleria y actos della."},{"folioId":"2v","text":"¶ Comiença la obra."},{"folioId":"4r","text":"¶ Capitulo prmero como"},{"folioId":"4r","text":"la infanta Elisena & su donzella Darioleta fue"},{"folioId":"4r","text":"ron ala camara donde el rey Perion estaua."},{"folioId":"5v","text":"¶ Capitulo .ij. Como el rey"},{"folioId":"5v","text":"Perion se yua por el camino con su escudero"},{"folioId":"5v","text":"con coraçon mas acompañado de tristeza que"},{"folioId":"5v","text":"de alegria."},{"folioId":"7v","text":"¶ Capitulo .iij. Como el"},{"folioId":"7v","text":"rey languines lleuo consigo al donzel del mar /"},{"folioId":"7v","text":"& a gandalin hijo de don gandales."},{"folioId":"9r","text":"¶ Capitulo .iiij. como el"},{"folioId":"9r","text":"Rey Lisuarte nauego por la mar: & aporto"},{"folioId":"9r","text":"al reyno de Escocia donde con mucha honra"},{"folioId":"9r","text":"fue recebido."},{"folioId":"11r","text":"¶ Capitulo .u como vrganda la"},{"folioId":"11r","text":"desconocida traxo vna lança al donzel del mar."},{"folioId":"13r","text":"¶ Capitulo .vj. Como el"},{"folioId":"13r","text":"donzel del mar se combatio con los peones del"},{"folioId":"13r","text":"cauallero que galpano se llamaua: y despues"},{"folioId":"13r","text":"con sus hermanos del señor del castillo y conel"},{"folioId":"13r","text":"mismo señor."},{"folioId":"14v","text":"¶ Capitulo .vij. como al"},{"folioId":"14v","text":"tercero dia que el donzel del mar se partio dela cor"},{"folioId":"14v","text":"te del rey languines: vinieron aquellos tres caua"},{"folioId":"14v","text":"lleros que trayan vn cauallero en vnas andas"},{"folioId":"14v","text":"& a su muger aleuosa."},{"folioId":"15r","text":"¶ Capitulo octauo como"},{"folioId":"15r","text":"el rey Lisuarte embio por su hija a casa del"},{"folioId":"15r","text":"rey languines / y el gela embio con su fija ma"},{"folioId":"15r","text":"bilia acompañadas de caualleros & dueñas"},{"folioId":"15r","text":"& donzellas."},{"folioId":"17v","text":"¶ Capitulo .ix. como el donzel"},{"folioId":"17v","text":"del mar hizo la batalla conel rey abies sobre la"},{"folioId":"17v","text":"guerra que tenia conel rey perion de gaula."},{"folioId":"19r","text":"¶ Capitulo .x. Como el"}],"glosses":[],"dropInitials":[{"folioId":"1v","text":"C","letter":"C","depth":10},{"folioId":"81r","text":"E","letter":"E","depth":10},{"folioId":"202r","text":"C","letter":"C","depth":10},{"folioId":"2v","text":"N","letter":"N","depth":8},{"folioId":"4r","text":"C","letter":"C","depth":4},{"folioId":"6r","text":"P","letter":"P","depth":4},{"folioId":"7v","text":"A","letter":"A","depth":4},{"folioId":"9r","text":"L","letter":"L","depth":4},{"folioId":"11v","text":"D","letter":"D","depth":4},{"folioId":"13r","text":"P","letter":"P","depth":4},{"folioId":"14v","text":"A","letter":"A","depth":4},{"folioId":"15r","text":"D",