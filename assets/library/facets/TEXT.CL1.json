{"format":"hsms-facets/1","baseName":"TEXT.CL1","witnessHash":"1:ms_rd5xzr","wordCount":306332,"typeCount":11755,"ttr":0.03837339879607746,"sttr":0.4067810457516346,"hapax":4932,"facets":{"rubrics":[{"folioId":"3r","text":"¶ Aqui comiença la ta"},{"folioId":"3r","text":"bla del presente libro."},{"folioId":"6r","text":"¶ Libro primero del muy esforçado y va"},{"folioId":"6r","text":"liente cauallero don Clarian de landanis: hijo del muy noble rey Lantedon"},{"folioId":"6r","text":"de Suecia y de la reyna damabela su muger. Enel qual se trata de los notables"},{"folioId":"6r","text":"y famosissimos fechos en armas que hizo. Por los quales gano el amor de la"},{"folioId":"6r","text":"fermosa infanta la señora Gradamisa hija del emperador Vasperaldo y de la"},{"folioId":"6r","text":"emperatriz Altibea. A la qual infanta vuo por muger por sus altas proezas."},{"folioId":"6v","text":"Capitulo primero de como"},{"folioId":"6v","text":"Gedres del fuerte braço fue en la pequeña bre"},{"folioId":"6v","text":"taña / y delas grandes cosas en armas que en"},{"folioId":"6v","text":"ayuda del rey yracoldo hizo."},{"folioId":"7v","text":"Capitulo .ij. como Lan"},{"folioId":"7v","text":"tedon fue cauallero & se partio dela corte del"},{"folioId":"7v","text":"rey Tanabel su padre."},{"folioId":"8r","text":"Capitulo .iij. de como Lan"},{"folioId":"8r","text":"tedon mato vn cauallero que yua en compa"},{"folioId":"8r","text":"ñia de vna donzella / y el se fue conella por se"},{"folioId":"8r","text":"hallar en vn torneo que en Nuruega se hazia."},{"folioId":"9r","text":"Capitulo .iiij. como yendo lan"},{"folioId":"9r","text":"tedon por vna floresta con su donzella qua"},{"folioId":"9r","text":"tro caualleros sela quisieron quitar / & se com"},{"folioId":"9r","text":"batio conellos."},{"folioId":"10r","text":"Capitulo .u. de como el"},{"folioId":"10r","text":"conde Belano dio vn cauallo a Lantedon"},{"folioId":"10r","text":"porque fuesse enel torneo de su parte."},{"folioId":"10v","text":"Capitulo .vj. de como to"},{"folioId":"10v","text":"dos los altos hombres entraron enla ciudad:"},{"folioId":"10v","text":"donde Lantedon fue preso de amores de"},{"folioId":"10v","text":"Damauela."},{"folioId":"11r","text":"Capitulo .vij. como se co"},{"folioId":"11r","text":"menço el torneo: & delas grandes cauallerias"},{"folioId":"11r","text":"que el cauallero estraño enel hizo."},{"folioId":"12v","text":"Capitulo .viij. del gran pesar que"},{"folioId":"12v","text":"todos los altos hombres ouieron por no sa"},{"folioId":"12v","text":"ber que se hiziera el cauallero estraño."},{"folioId":"13r","text":"Capitulo .ix. del segundo"},{"folioId":"13r","text":"torneo: & delo que el cauallero estraño enel"},{"folioId":"13r","text":"hizo."},{"folioId":"14r","text":"Capitulo .x. como el rey fue"},{"folioId":"14r","text":"a ver al de las armas verdes & lo conoscio &"},{"folioId":"14r","text":"lo traxo consigo: & Damauela se enamoro del."},{"folioId":"15r","text":"Capitulo .xj. como damauela"},{"folioId":"15r","text":"descubrio su coraçon ala donzella que con lantedon vi"},{"folioId":"15r","text":"niera: la qul tvo manera que ambos se fablassen."},{"folioId":"15v","text":"Capitulo .xij. como Lan"},{"folioId":"15v","text":"tedon se partio para Alemaña: & como fue"},{"folioId":"15v","text":"bien recebido del emperador Macelao & de"}],"glosses":[],"dropInitials":[{"folioId":"2r","text":"E","letter":"E","depth":8},{"folioId":"6r","text":"E","letter":"E","depth":8},{"folioId":"6v","text":"A","letter":"A","depth":4},{"folioId":"7v","text":"D","letter":"D","depth":4},{"folioId":"8r","text":"D","letter":"D","depth":4},{"folioId":"10r","text":"M","letter":"M","depth":4},{"folioId":"10v","text":"V","letter":"V","depth":4},{"folioId":"12v","text":"A","letter":"A","depth":4},{"folioId":"13r","text":"O","letter":"O","depth":4},{"folioId":"14r","text":"C","letter":"C","depth":4},{"folioId":"15r","text":"D","letter":"D","depth":4},{"folioId":"15v","text":"A","letter":"A","depth":4},{"fo