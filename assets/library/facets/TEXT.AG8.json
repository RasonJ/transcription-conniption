{"format":"hsms-facets/1","baseName":"TEXT.AG8","witnessHash":"1:ms_kyf4mj","wordCount":310115,"typeCount":12430,"ttr":0.04008190509972107,"sttr":0.41554516129032265,"hapax":4997,"facets":{"rubrics":[{"folioId":"1r","text":"El octauo libro de Ama"},{"folioId":"1r","text":"dis: que trata delas estra"},{"folioId":"1r","text":"ñas auenturas y grandes"},{"folioId":"1r","text":"proezas de su nieto Lisu"},{"folioId":"1r","text":"arte. y de la muerte del in"},{"folioId":"1r","text":"clito rey Amadis. 1526"},{"folioId":"2r","text":"¶ Prologo del octauo libro de amadis de gau"},{"folioId":"2r","text":"la. Dirigido al illustrissimo señor don Jorge hijo del inuictissimo rey don Juan"},{"folioId":"2r","text":"el segundo de portogal maestro de Vis y sanctiago: duque de Coimbra: señor de mon"},{"folioId":"2r","text":"temayor el viejo: y torres nouas: y delas Behetrias. Fecho por Juan diaz bachiller"},{"folioId":"2r","text":"en canones."},{"folioId":"3v","text":"¶ Comiença el octauo libro del rey Amadis en"},{"folioId":"3v","text":"que se recuentan las grandes proezas & famosos hechos del muy esforçado cauallero Li"},{"folioId":"3v","text":"suarte su nieto hijo del emperador Esplandian: y dela perdicion dela Insula firme: y como fue"},{"folioId":"3v","text":"cobrada: y dela muerte del rey Amadis: y delo que despues se hizo."},{"folioId":"3v","text":"¶ Capitulo prmero de"},{"folioId":"3v","text":"como el emperador Esplandian partio dela"},{"folioId":"3v","text":"gran Bretaña para Constantinopla. Y de"},{"folioId":"3v","text":"lo que enel camino le acaescio."},{"folioId":"4r","text":"¶ Capitulo .ij. delas gran"},{"folioId":"4r","text":"des fiestas y recebimiento que hizieron al empera"},{"folioId":"4r","text":"dor en su llegada y del gran plazer que el y la"},{"folioId":"4r","text":"emperatriz ouieron con su hijo Lisuarte."},{"folioId":"5r","text":"¶ Capitulo .iij. De como ⇒"},{"folioId":"5r","text":"se supo quien era el cauallero pagano &"},{"folioId":"5r","text":"como se llamaua & la causa de su demanda."},{"folioId":"6v","text":"¶ Capitulo .iiij. de como el"},{"folioId":"6v","text":"emperador supo la contratacion delos paganos"},{"folioId":"6v","text":"y delo que Lisuarte dixo al emperador su pa"},{"folioId":"6v","text":"dre. y como alçaron la prsion a Cosdroel."},{"folioId":"7v","text":"¶ Capitulo .u. del conse"},{"folioId":"7v","text":"jo que ouo el emperador Esplandian con sus caua"},{"folioId":"7v","text":"lleros & altos hombres de su imperio: y de co"},{"folioId":"7v","text":"mo hizo saber al rey Amadis su padre las"},{"folioId":"7v","text":"nueuas que sabia delos paganos."},{"folioId":"9r","text":"¶ Capitulo .vj. como Li"},{"folioId":"9r","text":"suarte saliendo a caça fallo vna espantable"},{"folioId":"9r","text":"auentura: & como se partio del bosque sin que"},{"folioId":"9r","text":"nadie lo viesse con dos donzellas estrañas."},{"folioId":"10v","text":"¶ Capitulo septimo de"},{"folioId":"10v","text":"como Lisuarte & su compañero con las don"},{"folioId":"10v","text":"zellas entraron enla mar: & salidos en tierra"},{"folioId":"10v","text":"se fueron ala insula no hallada do era Vr"},{"folioId":"10v","text":"ganda la desconocida."},{"folioId":"12v","text":"¶ Capitulo .viij. De co"},{"folioId":"12v","text":"mo don Falangris hallando menos a Li"},{"folioId":"12v","text":"suarte se dio a buscar lo por todo el bosque:"},{"folioId":"12v","text":"& como no lo hallando lo hizo saber al em"}],"glosses":[{"folioId":"88v","text":"[^gra","type":"gloss"},{"folioId":"88v","text":"do]","type":"gloss"}],"dropInitials":[{"folioId":"2r","text":"C","letter":"C","depth":9},{"folioId":"3v","text":"H","letter":"H","depth":9},{"folioId":"4r","text":"A","letter":"A","depth":4},{"folioId":"5r","text":"D","letter":"D","depth":4},{"folioId":"6v","text":"D","letter":"D","depth":4},{"folioId":"8r","text":"O","letter":"O","depth":4},{"folioId":"9r","text":"D","letter":"D","depth":4},{"folioId":"11r","text":"C","letter":"C","depth":4},{"folioId":"13r","text":"C",