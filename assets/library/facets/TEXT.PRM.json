{"format":"hsms-facets/1","baseName":"TEXT.PRM","witnessHash":"1:ms_9q6qav","wordCount":355390,"typeCount":13091,"ttr":0.03683558907116126,"sttr":0.39671267605633803,"hapax":6555,"facets":{"rubrics":[{"folioId":"1r","text":"Al yllustre & assi magnifico señor don Luys de cordoua."},{"folioId":"2r","text":"¶ Libro segundo del Emperador Palmerin en que"},{"folioId":"2r","text":"se recuentan [...] los grandes & hazañosos fechos de Primaleon & Polendus sus fijos & de o"},{"folioId":"2r","text":"tros buenos caualleros estrangeros que a su corte vinieron."},{"folioId":"3r","text":"¶ Capitulo .iij. como Alderina la hija del duque"},{"folioId":"3r","text":"de ponte rogo a Belcar que no se partiesse de al"},{"folioId":"3r","line":"li","text":"& que si yua a los torneos que se yria conel duque su"},{"folioId":"3r","text":"señor & de como belcar le suplico que lo perdo"},{"folioId":"3r","text":"nasse que no podia complir su mandado."},{"folioId":"4r","text":"¶ Capitulo .iij . como Belcar se despidio de sus"},{"folioId":"4r","text":"compañeros & se salio dela corte por no ser co"},{"folioId":"4r","text":"noscido & delas grandes auenturas que yendo su"},{"folioId":"4r","text":"camino le acontecieron."},{"folioId":"5r","text":"¶ Capitulo .cinco. Como el hijo dela due"},{"folioId":"5r","text":"ña le conto de que manera [...] era cercada la ysla"},{"folioId":"5r","text":"de carderia & la manera que tenia el caualle"},{"folioId":"5r","text":"ro que guardaua la entrada en se combatir &"},{"folioId":"5r","text":"de como Belcar determino de yr alla & se com"},{"folioId":"5r","text":"batio conel cauallero & lo vencio mas no pu"},{"folioId":"5r","text":"do entrar enel castillo porque las puertas fu"},{"folioId":"5r","text":"eron cerradas."},{"folioId":"6r","text":"¶ Capitulo sesto Como Belcar determi"},{"folioId":"6r","text":"no destar al Castillo de Francelina para se"},{"folioId":"6r","text":"combatir con todos los Caualleros que vi"},{"folioId":"6r","text":"niessen a probarse en aquella auentura por eno"},{"folioId":"6r","text":"jo que de si mesmo tenia por el daño que alli"},{"folioId":"6r","text":"auia rescebido. & no auia podido acabarla."},{"folioId":"7r","text":"¶ Capitulo .vj. Como Tirendos llego adonde"},{"folioId":"7r","text":"estaua la donzella que andaua por hazer ma"},{"folioId":"7r","text":"tar a Belcar. & como por sus llantos & por"},{"folioId":"7r","text":"conoscer a Seregin que era mucho su ami"},{"folioId":"7r","text":"go se le offrescio dela vengar del cauallero."},{"folioId":"8r","text":"¶ Capitulo .viij. Como Polendos supo que era"},{"folioId":"8r","text":"hijo del Emperador Palmerin & como pidio"},{"folioId":"8r","text":"licencia ala Reyna su madre para lo yr a ver &"},{"folioId":"8r","text":"como ella gela dio contra su voluntad"},{"folioId":"9r","text":"¶ Capitulo .ix. Como polendos enbarco para yr a ⇒"},{"folioId":"9r","text":"grecia o adonde su ventura lo guiasse & como"},{"folioId":"9r","text":"aporto ala ysla de delfos & lo que enella le acon"},{"folioId":"9r","text":"tescio."},{"folioId":"10r","text":"¶ Capitulo .ix. como Polendos se combatio"},{"folioId":"10r","text":"con vn hijo del señor dela ysla de delfos & de"},{"folioId":"10r","text":"como lo vencio Polendos & despues vencio"},{"folioId":"10r","text":"a su padre"},{"folioId":"11r","text":"¶ Capitulo .honze. como entre los otros ca"},{"folioId":"11r","text":"ualleros que polendos saco dela prision en"},{"folioId":"11r","text":"que estauan en poder del gigante Baladon"},{"folioId":"11r","text":"libro a Rifaran & a Lecefin su compañero."}],"glosses":[{"folioId":"1r","text":"Al muy Ill<ustrisi>mo s<eñor> domingue<z>","type":"gloss"}],"dropInitials":[{"folioId":"1r","text":"C","letter":"C","depth":11},{"folioId":"2r","text":"V","letter":"V","depth":9},{"folioId":"3r","text":"A","letter":"A","depth":4},{"folioId":"4r","text":"C","letter":"C","depth":4},{"folioId":"5r","text":"A","letter":"A","depth":4},{"folioId":"6r","text":"M","letter":"M","depth":4},{"folioId":"7r",