on cauayllo &"},{"folioId":"16r","text":"armas con sus uezinos."},{"folioId":"16r","text":"En quoal manera puede fidal"},{"folioId":"16r","text":"go fer camio con el Rey."},{"folioId":"16r","text":"por su prouecho. Quoal preso deue"},{"folioId":"16r","text":"fidalgo render al Rey."},{"folioId":"16r","text":"do le el Rey .C. morauidis. Ti"},{"folioId":"16r","text":"tulo de alferiz. de Ricoshom"},{"folioId":"16r","text":"bres. & de prestameros. Que deue"},{"folioId":"16r","text":"dar el Rey al su alferiz. & eyll a"},{"folioId":"16r","text":"que seruitio es tenido"},{"folioId":"16v","text":"onta. Que cosas le deuen fazer"},{"folioId":"16v","text":"los uillanos al Richombre o al"},{"folioId":"16v","text":"prestamero que ua albergar a su"},{"folioId":"16v","text":"honor. & como deuen taiar en"},{"folioId":"16v","text":"el mont & quoanto."}],"glosses":[],"dropInitials":[{"folioId":"1r","text":"P","letter":"P","depth":4},{"folioId":"13r","text":"P","letter":"P","depth":4},{"folioId":"20v","text":"E","letter":"E","depth":4},{"folioId":"37v","text":"E","letter":"E","depth":4},{"folioId":"13r","text":"A","letter":"A","depth":2},{"folioId":"13v","text":"E","letter":"E","depth":2},{"folioId":"14r","text":"T","letter":"T","depth":2},{"folioId":"14r","text":"D","letter":"D","depth":2},{"folioId":"14v","text":"S","letter":"S","depth":2},{"folioId":"15v","text":"S","letter":"S","depth":2},{"folioId":"16r","text":"Q","letter":"Q","depth":2},{"folioId":"16r","text":"S","letter":"S","depth":2},{"folioId":"16r","text":"T","letter":"T","depth":2},{"folioId":"16r","text":"S","letter":"S","depth":2},{"folioId":"16r","text":"E","letter":"E","depth":2},{"folioId":"16v","text":"S","letter":"S","depth":2},{"folioId":"17r","text":"C","letter":"C","depth":2},{"folioId":"17r","text":"E","letter":"E","depth":2},{"folioId":"17r","text":"E","letter":"E","depth":2},{"folioId":"17v","text":"E","letter":"E","depth":2},{"folioId":"17v","text":"N","letter":"N","depth":2},{"folioId":"17v","text":"M","let