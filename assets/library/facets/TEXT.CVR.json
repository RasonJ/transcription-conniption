xt":"Capitulo once: delo que aca"},{"folioId":"17r","text":"escio a Lope de Ouiedo con vnos indios."},{"folioId":"17v","text":"Capitulo doze, como los in"},{"folioId":"17v","text":"dios nos truxeron de comer."},{"folioId":"19r","text":"Capitulo treze, como supimos"},{"folioId":"19r","text":"de otros christianos."},{"folioId":"19v","text":"Capitulo catorze: como se par"},{"folioId":"19v","text":"tieron quatro christianos."},{"folioId":"21r","text":"Capitulo quinze: delo que nos"},{"folioId":"21r","text":"acaescio enla villa de Malhado."},{"folioId":"22r","text":"Capitulo diez y seys como se"},{"folioId":"22r","text":"partieron los christianos dela ysla"},{"folioId":"22r","text":"de Malhado."},{"folioId":"23v","text":"Capitulo diez y siete: como vinie"},{"folioId":"23v","text":"ron los indios, y truxeron a Andres dorantes y"}],"glosses":[],"dropInitials":[{"folioId":"1v","text":"P","letter":"P","depth":15},{"folioId":"2r","text":"E","letter":"E","depth":10},{"folioId":"3r","text":"A","letter":"A","depth":7},{"folioId":"24r","text":"D","letter":"D","depth":7},{"folioId":"4v","text":"E","letter":"E","depth":6},{"folioId":"5r","text":"E","letter":"E","depth":6},{"folioId":"5v","text":"O","letter":"O","depth":6},{"folioId":"7v","text":"S","letter":"S","depth":6},{"folioId":"9v","text":"L","letter":"L","depth":6},{"folioId":"9v","text":"L","letter":"L","depth":6},{"folioId":"12r","text":"O","letter":"O","depth":6},{"folioId":"13v","text":"A","letter":"A","depth":6},{"folioId":"15v","text":"U","letter":"U","depth":6},{"folioId":"17r","text":"D","letter":"D","depth":6},{"folioId":"17v","text":"O","letter":"O","depth":6},{"folioId":"19r","text":"E","letter":"E","depth":6},{"folioId":"19v","text":"P","letter":"P","depth":6},{"folioId":"21r","text":"E","letter":"E","depth":6},{"folioId":"22r","text":"D","letter":"D","depth":6},{"folioId":"25v","text":"E","letter":"E","depth":6},{"folioId":"28r","text":"Q","letter":"Q","depth":6},{"folioId":"29r","text":"D","letter":"D","depth":