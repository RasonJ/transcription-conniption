{"format":"hsms-facets/1","baseName":"TEXT.GRO","witnessHash":"1:ms_6isz0t","wordCount":181189,"typeCount":11562,"ttr":0.06381182080589881,"sttr":0.4064364640883978,"hapax":6018,"facets":{"rubrics":[{"folioId":"1r","text":"Coronica del noble caualle"},{"folioId":"1r","text":"ro Guarino Mesquino. En"},{"folioId":"1r","text":"la qual trata delas grandes hazañas y auenturas que"},{"folioId":"1r","text":"le acontescieron por todas las partes del mundo y en"},{"folioId":"1r","text":"el purgatorio de Sant Patricio y enel monte de Nor"},{"folioId":"1r","text":"ça: donde esta la muy sabia Sybila."},{"folioId":"1v","text":"¶ Tabla del presente libro."},{"folioId":"1v","text":"¶ Libro primero"},{"folioId":"1v","text":"¶ Libro segundo."},{"folioId":"2r","text":"¶ Libro tercero."},{"folioId":"2v","text":"¶ Libro quarto."},{"folioId":"2v","text":"Libro quinto."},{"folioId":"3r","text":"¶ Libro sexto."},{"folioId":"3v","text":"Libro septimo."},{"folioId":"3v","text":"Libro octauo."},{"folioId":"4r","text":"¶ Aqui se acaba la tabla & si"},{"folioId":"4r","text":"gue se el prohemio []"},{"folioId":"4v","text":"¶ En aqueste libro vulgarmente se trata vna breue historia"},{"folioId":"4v","text":"del rey carlo magno: y despues del nascimiento & obras de aquel generoso & muy mag"},{"folioId":"4v","text":"nifico cauallero llamado Guarino: & despues llamado mezquno: enel qual se muestran los"},{"folioId":"4v","text":"nombres delas prouincias qusi de todo el mundo: y dela diuersidad delos hombres & de sus di"},{"folioId":"4v","text":"uersas costumbres: & de muchos y diuersos animales & dela habitacion dela Sibila: & del"},{"folioId":"4v","text":"purgatorio de sant patricio: & del infierno segun la hystoria lo declarar a . El qul libro mudo"},{"folioId":"4v","text":"o traslado de lengua toscana en nuestro romance castellano Alonso hernandez aleman vezino"},{"folioId":"4v","text":"de Seuilla. a ruego del noble cauallero don Pero ponce de Leon: hijo del noble caualle"},{"folioId":"4v","text":"ro el maryscal Juan ramirez de Guzman: señor de Teba y hardales."},{"folioId":"4v","text":"¶ Prologo"},{"folioId":"5r","text":"¶ Comiença el libro primero del noble: esforçado & muy virtu"},{"folioId":"5r","text":"oso cauallero Guarino mezquino el qual en busca de su generacion andvo todas las parti"},{"folioId":"5r","text":"das del mundo. El qual trata delas estrañas auenturas de que le auinieron. Y delas grandes"},{"folioId":"5r","text":"proezas & muy famosas vitorias & conquistas que en su tiempo ouo."},{"folioId":"5r","text":"¶ Capitulo primero como de"},{"folioId":"5r","text":"los dela nacion del duque de Borgoña fueron re"},{"folioId":"5r","text":"yes & señores de Pulia & del principado de"},{"folioId":"5r","text":"taranto: & de donde nacio el Mezquino."},{"folioId":"5r","text":"¶ Capitulo segundo como mi"},{"folioId":"5r","text":"lon se delibro de fazer guerra alos Albane"},{"folioId":"5r","text":"ses & fizo lo por amor de Fenisa dela qual na"},{"folioId":"5r","text":"cio el Mezquino."},{"folioId":"5v","text":"¶ Capitulo .iij. como Milon"},{"folioId":"5v","text":"con la gente delos xpistianos paso en albania: &"},{"folioId":"5v","text":"tomo a duraço: & tomo a Fenisa por muger."},{"folioId":"6r","text":"Capitulo quarto como Milon"},{"folioId":"6r","text":"ouo vn hijo llamado Guarino: & como per"},{"folioId":"6r","text":"dio la cibdad de Duraço: & fue puesto en pri"},{"folioId":"6r","text":"sion el & su muger Fenisa: y estvo assi preso"},{"folioId":"6r","text":"treynta & dos años."},{"folioId":"6v","text":"¶ Capitulo cinco como sefera"}],"glosses":[],"dropInitials":[{"folioId":"4v","text":"G","letter":"G","depth":9},{"folioId":"18r","text":"D","letter":"D","depth":9},{"folioId":"35v","text":"D","letter":"D","depth":9},{"folioId":"55v","text":"P","letter":"P","depth":9},{"folioId":"71v","text":"E","letter":"E","depth":9},{"folioId":"99r","text":"H","letter":"H","depth":9},{"folioId":"109r","text":"E","letter":"E","depth":9},{"folioId":"5r","text":"R","letter"