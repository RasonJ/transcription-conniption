{"format":"hsms-facets/1","baseName":"TEXT.ADJ","witnessHash":"1:ms_26uhpb","wordCount":9118,"typeCount":1632,"ttr":0.1789866198727791,"sttr":0.3957777777777778,"hapax":856,"facets":{"rubrics":[{"folioId":"1r","text":"¶ Prologo."},{"folioId":"1r","text":"¶ Comiença el libro del abad don Juan"},{"folioId":"1r","text":"señor de montemayor. en el qual se escriue todo lo que"},{"folioId":"1r","text":"le acontescio con don Garcia su criado."},{"folioId":"2r","text":"¶ Dela honrra que fizo el rey Ramiro"},{"folioId":"2r","text":"de Leon a don Garcia / criado del abad don Juan."},{"folioId":"2v","text":"¶ De como el abad don Juan salio a re"},{"folioId":"2v","text":"cebir a don garcia su criado & dela honrra que le fizo."},{"folioId":"2v","text":"¶ De como don garcia comidio & orde"},{"folioId":"2v","text":"no de dexar la fe xpistiana & de tornarse moro."},{"folioId":"3v","text":"¶ De como el traydor don garcia deman"},{"folioId":"3v","text":"do licencia al abad don Juan para yr a guerrear con"},{"folioId":"3v","text":"tra el rey Almançor."},{"folioId":"5r","text":"De como el rey almançor mando tor"},{"folioId":"5r","text":"nar moro a don Garcia."},{"folioId":"6r","text":"¶ De como truxo las nueuas Bermu"},{"folioId":"6r","text":"do martinez al abad don Juan su sobrino: de como su"},{"folioId":"6r","text":"criado Garcia se era tornado moro."},{"folioId":"6v","text":"Agora dexa de hablar del abad don"},{"folioId":"6v","text":"Juan: & del duelo que hazia enel castillo / & torna a hab"},{"folioId":"6v","text":"lar dela honrra que el rey almançor hazia a don çulema."},{"folioId":"6v","text":"¶ De como el traydor don çulema de"},{"folioId":"6v","text":"mando merced al rey almançor que le dexase yr a dar"},{"folioId":"6v","text":"guerra alos cristianos: & que el haria cosa que sonasse"},{"folioId":"6v","text":"por todo el mundo."},{"folioId":"7r","text":"¶ De como el rey almançor & don çulema"},{"folioId":"7r","text":"salieron de cordoua para destruyr alos xpistianos."},{"folioId":"8r","text":"¶ De como el traydor don çulema entro"},{"folioId":"8r","text":"enla yglesia de santiago: & durmio consu muger enel altar"},{"folioId":"9r","text":"¶ De como el traydor don çulema de"},{"folioId":"9r","text":"zia al abad don juan que se tornase moro."},{"folioId":"9v","text":"¶ De como hazia oracion el abad don"},{"folioId":"9v","text":"juan a nuestro señor: & dela respuesta que lleuo el tray"},{"folioId":"9v","text":"dor don çulema al rey almançor: & de como vencio dos"},{"folioId":"9v","text":"batallas: & enla postrera como fuera tan vencedor."},{"folioId":"11v","text":"¶ De como fueron los moros empos"},{"folioId":"11v","text":"del abad don juan: & el abad con su conpaña tornaron"},{"folioId":"11v","text":"a ellos & mataron muchos."},{"folioId":"12v","text":"¶ De como el abad don Juan les daua"},{"folioId":"12v","text":"muy buen consejo: & dela cuyta & del mal que tenian."}],"glosses":[],"dropInitials":[{"folioId":"1r","text":"P","letter":"P","depth":3},{"folioId":"1v","text":"E","letter":"E","depth":3},{"folioId":"2r","text":"E","letter":"E","depth":3},{"folioId":"2v","text":"E","letter":"E","depth":3},{"folioId":"3r","text":"U","letter":"U","depth":3},{"folioId":"3v","text":"D","letter":"D","depth":3},{"folioId":"5r","text":"D","letter":"D","depth":3},{"folioId":"6r","text":"O","letter":"O","depth":3},{"folioId":"6v","text":"Q","letter":"Q","depth":3},{"folioId":"7r","text":"A","letter":"A","depth":3},{"folioId":"7v","text":"Q","letter":"Q","depth":3},{"folioId":"8r","text":"E","letter":"E","depth":3},{"folioId":"9r","text":"E","letter":"E","depth":3},{"folioId":"9v","text":"D","letter":"D","depth":3},{"folioId":"11v","text":"E","letter":"E","depth":3},{"folioId":"12v","text":"E","letter":"E","depth":3}],"codeSwitching":[],"hands":[{"hand":"2","count":1}],"blockCounts":{"rubric":40,"prose":932},"tokenCounts":{"text":20699,"expansion":765,"editorial_deletion":23,"drop_initial":16,"hyphen":363,"editorial_insertion":23,"blank_space":8,"superscript"