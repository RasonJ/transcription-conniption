{"format":"hsms-facets/1","baseName":"TEXT.DC2","witnessHash":"1:ms_1qpnuft","wordCount":12651,"typeCount":3696,"ttr":0.2921508181171449,"sttr":0.5411666666666667,"hapax":2459,"facets":{"rubrics":[{"folioId":"1r","text":"El caton en latin: & en romançe."},{"folioId":"1v","text":"Prologo del doctor Gonçalo garcia de"},{"folioId":"1v","text":"sancta maria: en la obrezilla vulgarmente"},{"folioId":"1v","text":"llamada el caton: por el dicho micer Gon"},{"folioId":"1v","text":"çalo trasladada en coplas."},{"folioId":"5r","text":"honorem contingerent."},{"folioId":"5r","text":"& non intelligere: negligere est."},{"folioId":"5v","text":"cole. foro te para. datum serua."},{"folioId":"5v","text":"Cum bonis ambula. Mutvm da."},{"folioId":"5v","text":"silium non accesseris. conuiua raro."},{"folioId":"6r","text":"saluta libenter."},{"folioId":"6r","text":"metue. verecundiam serua."},{"folioId":"6r","text":"familiam cura. liberos erudi."},{"folioId":"6v","text":"Blandus esto. irasci ab re noli."},{"folioId":"6v","text":"ua. vino te tempera."},{"folioId":"6v","text":"Pugna pro patria. nil temere credideris."},{"folioId":"7r","text":"letras disce. quod legeris memento. nil mentire"},{"folioId":"7r","text":"maledicus ne esto."},{"folioId":"7r","text":"Consultus esto. iracundiam tempera."},{"folioId":"7v","text":"tempseris. miserum noli irridere."},{"folioId":"7v","text":"quam ipse tuleris. alienum noli concupiscere"},{"folioId":"7v","text":"tienter vince. beneficii accepti memor esto"},{"folioId":"8r","text":"iustum est. libenter amorem ferto."},{"folioId":"8r","text":"Fenece el plorogo del auctor:"},{"folioId":"8r","text":"E comiença la obra."},{"folioId":"8r","text":"Hic tibi precipue sit pura mente +"},{"folioId":"8r","text":"¶ Si el animo nuestro: es assi como vn dios colendus"},{"folioId":"8v","text":"Nam diuturna ques vitijs alimenta ministrat +"},{"folioId":"8v","text":"¶ Uela tu mucho: & fuye del sueño:"},{"folioId":"8v","text":"Proximus ille deo est qu scit ratione tacere"},{"folioId":"8v","text":"Conueniet nulli qui secum dissidet ipse."},{"folioId":"9r","text":"Cum culpent alios: nemo sine crimine viuit."},{"folioId":"9r","text":"vtilitas opibus preponi tempore debet."},{"folioId":"9r","text":"Temporibus mores sapiens sine crimine mutat"},{"folioId":"9v","text":"Sepe et [...] enim mulier quem coniunx diligit +"},{"folioId":"9v","text":"¶ No creas luego: quando tu mujer odit."},{"folioId":"9v","text":"Cumque mones aliquem nec se velit ipse moneri: +"},{"folioId":"9v","text":"si tibi sit carus noli desistere ceptis."},{"folioId":"9v","text":"Contra uerbosos: noli contendere verbis."},{"folioId":"10r","text":"Sermo datur cunctis animi sapientia paucis"},{"folioId":"10r","text":"Sic bonus esto bonis: ne te mala damna +"},{"folioId":"10r","text":"¶ Ama los otros: mas a ti no oluides: sequantur"},{"folioId":"10r","text":"Nam nulli tacuisse nocet: nocet esse locutum."},{"folioId":"10v","text":"Rara fides ideo quia multi multa loqvntur"},{"folioId":"10v","text":"Plus alijs de te: qum tu tibi credere noli"},{"folioId":"10v","text":"Atque alijs cum tu benefeceris ipse sileto."},{"folioId":"11r","text":"Fac tibi succurrant ivenis que feceris ipse."},{"folioId":"11r","text":"Conscius ipse sibi de se putat omnia dici"}],"glosses":[],"dropInitials":[{"folioId":"5r","text":"C","letter":"C","depth":3},{"folioId":"8r","text":"S","letter":"S","depth":3},{"folioId":"15v","text":"T","letter":"T","depth":3},{"folioId":"22r","text":"H","letter":"H","depth":3},{"folioId":"27r","text":"S","letter":"S","depth":3}],"codeSwitching":[{"lang":"LAT","words":2333,"tokens":6383,"spans":366}],"hands":[],"blockCounts":{"rubric":211,"prose":1526,"language_span":177},"tokenCounts":{"text":28676,"expansion":1625,"hyphen":89,"superscript":62,"blank_space":11,"editorial_insertion":22,"editorial_deletion":18,"drop_initial":5,"scribal_insertion":6}},"termFreq":{"que":590,"muy":150,"con":147,"mas":130,"por":119,"los":105,"como":68,"porque":67,"las":65,"mucho":62,"del":53