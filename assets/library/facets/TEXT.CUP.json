rdona"},{"folioId":"7v","text":"por quatro cosas."},{"folioId":"7v","text":"¶ Los pecados mortales son siete."},{"folioId":"7v","text":"Contra estos siete vicios ay siete"},{"folioId":"7v","text":"virtudes sus contrarias."},{"folioId":"7v","text":"¶ Las virtudes en general son siete."},{"folioId":"7v","text":"Las tres primeras Theologicas."},{"folioId":"7v","text":"¶ Las quatro Cardinales."},{"folioId":"8r","text":"¶ Las obras de misericordia son catorze."},{"folioId":"8r","text":"Las siete primeras son corporales."},{"folioId":"8r","text":"¶ Las otras siete son espirituales."},{"folioId":"8r","text":"¶ Los dones del espiritu sancto, son siete."},{"folioId":"8v","text":"¶ Los sentidos corporales, son cinco."},{"folioId":"8v","text":"¶ Las potencias del alma, son tres."},{"folioId":"8v","text":"¶ Los enemigos del alma, son tres."}],"glosses":[],"dropInitials":[{"folioId":"1v","text":"P","letter":"P","depth":7},{"folioId":"9r","text":"E","letter":"E","depth":7},{"folioId":"4r","text":"E","letter":"E","depth":2},{"folioId":"5v","text":"T","letter":"T","depth":2},{"folioId":"7r","text":"P","letter":"P","depth":2},{"folioId":"10r","text":"P","letter":"P","depth":8},{"folioId":"21r","text":"A","letter":"A","depth":4}],"codeSwitching":[{"lang":"LAT","words":16,"tokens":35,"spans":8}],"hands":[],"blockCounts":{"rubric":113,"prose":1125,"language_span":6},"tokenCounts":{"text":20407,"hyphen":368,"expansion":540,"drop_initial":7,"editorial_insertion":5,"blank_space":4,"editorial_deletion":2,"superscript":2}},"termFreq":{"que":358,"los":149,"por":122,"con":90,"peccado":90,"del":82,"son":78,"las":77,"para":72,"como":63,"mortal":63,"dios":58,"porque":51,"cosas":46,"dela":45,"cosa":43,"contra":41,"esto":40,"quando":40,"otro":39,"mas":37,"yglesia":37,"peccados":35,"hazer":31,"algun":28,"vno":27,"alguna":26,"confessar":26,"delos":26,"enla":25,"haze":25,"sus":25,"mal":23,"alguno":22,"mortales":22,"sea":22,"sin":22,"luxuria":21,"muger":21,"otra":20,"pero":20,"aunque":19,"delas":19,"e