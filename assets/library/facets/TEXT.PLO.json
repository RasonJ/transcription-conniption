{"format":"hsms-facets/1","baseName":"TEXT.PLO","witnessHash":"1:ms_v79pql","wordCount":237989,"typeCount":10002,"ttr":0.042027152515452394,"sttr":0.3953924050632915,"hapax":4825,"facets":{"rubrics":[{"folioId":"1r","text":"Palmerin de Oliua."},{"folioId":"1r","text":"Libro del famoso & muy esfor"},{"folioId":"1r","text":"çado cauallero Palmerin de Oliua & de sus grandes"},{"folioId":"1r","text":"fechos. Nueuamente [...] corregido & hystoriado."},{"folioId":"1v","text":"¶ Al yllustre & muy magnifico señor don Luys de Cordoua"},{"folioId":"1v","text":"hijo del muy yllustre & muy magnifico señor don Diego hernandez de Cordoua. conde de Cabra:"},{"folioId":"1v","text":"vizconde de Jsnajar. señor dela villa de Vaena &c."},{"folioId":"2v","text":"¶ Aqui comiença el libro del famoso cauallero Palmerin"},{"folioId":"2v","text":"de Oliua que [...] por el mundo [...] grandes fechos en armas fizo: sin saber [...] cuyo fijo fuesse. Mas la su"},{"folioId":"2v","text":"gran bondad le fizo alcançar grande honrra & venir en grande alteza despues de auer passado"},{"folioId":"2v","text":"grandes trabajos & afanes."},{"folioId":"2v","text":"¶ Comiença la hystoria."},{"folioId":"3v","text":"¶ Capitulo primero como la"},{"folioId":"3v","text":"emperatriz demando al emperador a su fija"},{"folioId":"3v","text":"Griana en casamiento para Tarisio fijo del"},{"folioId":"3v","text":"rey de Vngria: & como el gela otorgo."},{"folioId":"4v","text":"¶ Capitulo .ij. como guame"},{"folioId":"4v","text":"zir con fortuna aporto en constantinopla: & deter"},{"folioId":"4v","text":"mino dela combatir: y delo que enella le auino."},{"folioId":"5v","text":"¶ Capitulo .iij. como Floren"},{"folioId":"5v","text":"dos demando al emperador a su hija griana"},{"folioId":"5v","text":"para que gela diesse por muger y lo quel le respondio."},{"folioId":"6r","text":"¶ Capitulo .iiij. como Griana"},{"folioId":"6r","text":"embio con Cardin vn anillo de gran virtud a flo"},{"folioId":"6r","text":"rendos para remedio de su mal: & delo que le"},{"folioId":"6r","text":"mando dezir."},{"folioId":"6v","text":"¶ Capitulo .u. como cardin tor"},{"folioId":"6v","text":"no la respuesta a Griana / y se vieron enla hu"},{"folioId":"6v","text":"erta & lo que les acaescio."},{"folioId":"7v","text":"¶ Capitulo .vj. como Floren"},{"folioId":"7v","text":"dos vino la noche assmada para lleuar a Gria"},{"folioId":"7v","text":"n a como concertado tenian & delo que le acaescio"},{"folioId":"7v","text":"c on Tarisio."},{"folioId":"8v","text":"¶ Capitulo .vij. como Floren"},{"folioId":"8v","text":"dos fue en macedonia muy desconsolado porque"},{"folioId":"8v","text":"no pudo lleuar a Griana y lo que de alli fizo."},{"folioId":"9r","text":"Capitulo .viij. como tarisio siendo"},{"folioId":"9r","text":"guarido de sus feridas fablo conel emperador &"},{"folioId":"9r","text":"como le entrego a griana contra la voluntad de"},{"folioId":"9r","text":"lla & despues de salida dela torre pario vn niño"},{"folioId":"9r","text":"muy hermoso."},{"folioId":"10v","text":"¶ Capitulo .ix. como geraldo andan"},{"folioId":"10v","text":"do vn dia por la montaña fallo el niño y lo crio."},{"folioId":"11r","text":"¶ Capitulo .x. como el empe"},{"folioId":"11r","text":"rador caso a Griana con Tarisio & se despidio"},{"folioId":"11r","text":"del emperador & la leuo para vngria."},{"folioId":"11v","text":"¶ Capitulo .xj . como se torno"},{"folioId":"11v","text":"el escudero que [...] florendos auia embiado a costan"}],"glosses":[],"dropInitials":[{"folioId":"1v","text":"Q","letter":"Q","depth":8},{"folioId":"2v","text":"E","letter":"E","depth":8},{"folioId":"3v","text":"M","letter":"M","depth":4},{"folioId":"4v","text":"E","letter":"E","depth":4},{"folioId":"5v","text":"C","letter":"C","depth":4},{"folioId":"6r","text":"D","letter":"D","depth":4},{"folioId":"6v","text":"C","letter":"C","depth":4},{"folioId":"7v","text":"L","letter":"L","depth":4},{"folioId":"8v","text":"E","letter":"E","depth":4},{"folioId":"9v","text":"E"