{
  "name": "expo-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start:web-dev": "DEBUG=expo* bunx expo start -p jgwnsrd2enen3giqcjlx6 --web --tunnel",
    "start": "npx expo start",
    "start:web": "npx expo start --web",
    "start:tunnel": "npx expo start --tunnel",
    "start:web-tunnel": "npx expo start --web --tunnel",
    "start:dev": "npx expo start --dev-client",
    "start:clear": "npx expo start --clear",
    "build:web": "node node_modules/expo/bin/cli export --platform web",
    "build:android": "npx expo build:android",
    "build:ios": "npx expo build:ios",
    "lint": "npx expo lint",
    "lint:hsms": "npx tsx scripts/lint-hsms.ts",
    "lint:project": "npx tsx scripts/lint-hsms.ts --recursive",
    "test": "jest",
    "test:osta": "jest --config jest.osta.config.js --verbose --runInBand",
    "batch:osta": "npx tsx scripts/batch-convert-osta.ts",
    "build:library": "npx tsx scripts/build-library-catalog.ts",
    "sync:library": "npx tsx scripts/sync-library-public.ts",
    "report:osta": "npx tsx scripts/aggregate-osta-issues.ts",
    "generate:diacritics": "node scripts/generate-diacritic-map.mjs",
    "generate:dictionary": "node scripts/generate-hsms-dictionary-index.mjs",
    "generate:hsms-assets": "npm run generate:diacritics && npm run generate:dictionary"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@nkzw/create-context-hook": "^1.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rork-ai/toolkit-sdk": "^0.2.51",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.83.0",
    "@ungap/structured-clone": "^1.3.0",
    "expo": "~54.0.27",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.11",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.9",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.17",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^0.475.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "tsx": "^4.22.3",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "axios": "1.13.2"
  }
}
