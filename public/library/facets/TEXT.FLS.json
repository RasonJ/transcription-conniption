{"format":"hsms-facets/1","baseName":"TEXT.FLS","witnessHash":"1:ms_kk999v","wordCount":185791,"typeCount":10417,"ttr":0.0560683779085101,"sttr":0.414037837837838,"hapax":5047,"facets":{"rubrics":[{"folioId":"1v","text":"¶ INtroducion dela presente obra que se dirige al Illustre y"},{"folioId":"1v","text":"muy magnifico señor Marques delos velizes / adelantado del reyno de Murcia:"},{"folioId":"1v","text":"por el bachiller Hernando bernal / natural dela villa de Medellin."},{"folioId":"2r","text":"¶ Tabla dela presente obra."},{"folioId":"3v","text":"¶ Libro segundo."},{"folioId":"4v","text":"¶ Fin de la tabla."},{"folioId":"5r","text":"¶ Capitulo primero en que"},{"folioId":"5r","text":"se declara quien fueron su padre &"},{"folioId":"5r","text":"madre de floriseo cuya es la presen"},{"folioId":"5r","text":"te istoria."},{"folioId":"5v","text":"¶ Capitulo .ij. en que se cuenta el voto"},{"folioId":"5v","text":"que la duquesa primacia hizo de yr a ierusalem"},{"folioId":"5v","text":"& de como el duque su marido despues de a"},{"folioId":"5v","text":"uer passado muchas razones con ella hizo"},{"folioId":"5v","text":"el mismo voto."},{"folioId":"6r","text":"¶ Capitulo .iij. en que se cuenta de co"},{"folioId":"6r","text":"mo la duquesa primacia pario vn hijo a"},{"folioId":"6r","text":"quen pusieron nombre Floriseo de bohemia."},{"folioId":"6v","text":"¶ Capitulo .iiij. en que se dize como"},{"folioId":"6v","text":"el duque pirineo ordeno de sus cosas para"},{"folioId":"6v","text":"en su ausencia: & ordenado se partieron el"},{"folioId":"6v","text":"& su muger."},{"folioId":"7r","text":"¶ Capitulo .u. enel qual se cuenta ⇒"},{"folioId":"7r","text":"como el duque perineo boluiendo de ierusa"},{"folioId":"7r","text":"lem embarco para roma: & de como le suce"},{"folioId":"7r","text":"dio al contrario de su pensamiento."},{"folioId":"7v","text":"¶ Capitulo .vi. que dize de como"},{"folioId":"7v","text":"el duque & su compaña allegaron a tierra & de"},{"folioId":"7v","text":"como enella fueron apartados todos."},{"folioId":"8v","text":"¶ Capit(u) u lo .vij. en que se di"},{"folioId":"8v","text":"ze quien eran los que prendieron al duque"},{"folioId":"8v","text":"& donde lo lleuaron. & delo que enla isla"},{"folioId":"8v","text":"le sucedio."},{"folioId":"9v","text":"Capitulo .viij. delo que acon"},{"folioId":"9v","text":"tecio ala duquesa despues que el duque"},{"folioId":"9v","text":"se aparto della yendo tras el puerco."},{"folioId":"10r","text":"Capitulo .ix. como estando la du"},{"folioId":"10r","text":"quesa con su donzella & hijo vieron ve"},{"folioId":"10r","text":"nir por vn valle ayuso vn hombre: & delo"},{"folioId":"10r","text":"que conel passaron."},{"folioId":"11r","text":"¶ Capitulo .x. en que se dize de como"},{"folioId":"11r","text":"el duque salio de su insola primaciana & de co"},{"folioId":"11r","text":"mo fue cautiuo & dado al soldan & de como"},{"folioId":"11r","text":"estando en babilonia vino alli su mujer la"},{"folioId":"11r","text":"duquesa cautiua."},{"folioId":"11v","text":"¶ Capitulo .xj. [...] que cuenta de como"},{"folioId":"11v","text":"Constancia la donzella dela duquesa enla ri"},{"folioId":"11v","text":"bera donde quedo con Floriseo fue presa"}],"glosses":[],"dropInitials":[{"folioId":"1r","text":"F","letter":"F","depth":4},{"folioId":"5v","text":"S","letter":"S","depth":4},{"folioId":"6r","text":"P","letter":"P","depth":4},{"folioId":"6v","text":"V","letter":"V","depth":4},{"folioId":"7v","text":"D","letter":"D","depth":4},{"folioId":"8v","text":"E","letter":"E","depth":4},{"folioId":"9v","text":"M","letter":"M","depth":4},{"folioId":"10r","text":"E","letter":"E","depth":4},{"folioId":"11r","text":"D","letter":"D","depth":4},{"folioId":"11v","text":"D","letter":"D","depth":4},{"folioId":"12v","text":"Y","letter":"Y","depth":4},{"folioId":"13v","text":"Y","letter":"Y","depth":4},{"folioId":"14v","text":"M","letter":"M","depth":4},{"folioId":"15r","text":"T","letter":"T","depth":4},{"folioId":"16v","t