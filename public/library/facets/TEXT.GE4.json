{"format":"hsms-facets/1","baseName":"TEXT.GE4","witnessHash":"1:ms_1f7s5az","wordCount":418455,"typeCount":21169,"ttr":0.050588474268439855,"sttr":0.39599521531100496,"hapax":10482,"facets":{"rubrics":[{"folioId":"1r","text":"FAsta aqui Prologo."},{"folioId":"3r","text":"gund quelos fallaremos en los escriptos. De"},{"folioId":"3r","text":"la nacencia. & de la criança de Nabuchodonosor."},{"folioId":"3v","text":"De como Badiza fue al tiemplo de uenus"},{"folioId":"3v","text":"& como guarescio a la fija del Rey. Pahen"},{"folioId":"3v","text":"que era demoniada."},{"folioId":"4r","text":"su fija. De como el Rey Pahen caso su fija"},{"folioId":"4r","text":"con badiza."},{"folioId":"4v","text":"gund dizen algunos. De cuemo nascio"},{"folioId":"4v","text":"Nabuchodonosor & de lo que fizo Badiza"},{"folioId":"4v","text":"so padre."},{"folioId":"5r","text":"su adelantado en Judea. De como mataron"},{"folioId":"5r","text":"a Godolias."},{"folioId":"5r","text":"ualiesse. De cuemo se poblauan iherusalem &"},{"folioId":"5r","text":"Judea el primer año fecha la trsmigracion."},{"folioId":"5v","text":"Del conseio de Johaña a Godolias sobrel"},{"folioId":"5v","text":"fecho de ysmahel."},{"folioId":"6r","text":"omne. De como mato ysmahel a Godolias"},{"folioId":"6r","text":"& a otros. & fuxo."},{"folioId":"6v","text":"& fuxo antel. & fues poral Rey de Amon. De cue"},{"folioId":"6v","text":"mo fuxo el pueblo menudo de Judea a Egypto."},{"folioId":"7r","text":"blia. De como fizo el Rey Nabuchodono"},{"folioId":"7r","text":"sor sobre la muerte de Godolias."},{"folioId":"7r","text":"ellos. Del Rey de Egypto cuemo recibio"},{"folioId":"7r","text":"a Jheremias. & alos judios que fuxieron alla."},{"folioId":"7v","text":"truydo el Regno de Egypto. De como los de"},{"folioId":"7v","text":"Egypto sabien por sos sabios que la tierra se"},{"folioId":"7v","text":"auie a perder."},{"folioId":"8r","text":"acaescio. Del daño que los estrelleros & los"},{"folioId":"8r","text":"encantadores fizieron en egypto por lo que"},{"folioId":"8r","text":"el Rey les fiziera."},{"folioId":"8v","text":"De como mostraron los pueblos al Rey"},{"folioId":"8v","text":"el daño que les uinie por los estrelleros"},{"folioId":"8v","text":"& por los encantadores. & non dio por ello"},{"folioId":"8v","text":"nada."},{"folioId":"9v","text":"agora contar uos emos como. De las cosas"},{"folioId":"9v","text":"que el Rey Samnetico fazie enel regno & comol"},{"folioId":"9v","text":"desamauan sus pueblos."},{"folioId":"9v","text":"a prouaua mas & era meior. De lo que vaf"},{"folioId":"9v","text":"fre dixo al Rey so padre."},{"folioId":"10r","text":"sto. De lo que el Rey Samnetico dixo a so fijo +"},{"folioId":"10r","line":"XIX","text":"Fijo. Emporidad estamos Vaffre."},{"folioId":"10v","text":"a oramos. De como el Rey Samnetico des"},{"folioId":"10v","text":"crubio a so fijo el Rey uaffre en so poridad"},{"folioId":"10v","text":"que el regno de Egypto se auie a perder."},{"folioId":"11r","text":"omnes; pero siempre te ayudare a ello. De"},{"folioId":"11r","text":"como murio el Rey psalmnitis."},{"folioId":"11v","text":"sor. De como alçaron Rey a Vaffre despu"}],"glosses":[],"dropInitials":[{"folioId":"1r","text":"F","letter":"F","depth":10},{"folioId":"3r","line":"I","text":"M","letter":"M","depth":10},{"folioId":"76v","line":"I","text":"A","letter":"A","depth":10},{"folioId":"118r","line":"I","text":"A","letter":"A","depth":10},{"folioId":"119r","text":"E","letter":"E","depth":10},{"folioId":"120v","line":"I","text":"E","letter":"E","depth":10},{"folioId":"133v","line":"I","text":"C","letter":"C","depth":10},{"folioId":"144v","line":"I","text":"E","letter":"E","depth":10},{"folioId":"145v","line":"I","text":"E","letter":"E","depth":10},{"folioId":"150r","line":"I","text":"A","letter":"A","depth":10},{"folioId":"166v","line":"I","text":"E","letter":"E","depth":10},{"folioId":"170r","line":"I","text":"P","letter":"P","depth":10},{"folioId":"173v","line":"I","text":"D","letter":"D","dept