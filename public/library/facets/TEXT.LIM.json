{"format":"hsms-facets/1","baseName":"TEXT.LIM","witnessHash":"1:ms_r2xt54","wordCount":87335,"typeCount":10412,"ttr":0.11921909887215892,"sttr":0.48343678160919545,"hapax":5289,"facets":{"rubrics":[{"folioId":"2r","text":"Comiença el tractado de"},{"folioId":"2r","text":"johan bocaçio de certaldo poeta flo"},{"folioId":"2r","text":"rentin delas claras / excellentes y mas fa"},{"folioId":"2r","text":"mosas & señaladas damas: adreçado"},{"folioId":"2r","text":"ala muy illustre señora / doña andrea"},{"folioId":"2r","text":"de acchiarolis condessa de alta villa."},{"folioId":"2r","text":"El prohemio del auctor."},{"folioId":"3r","text":"Entrada para la obra."},{"folioId":"5r","text":"De nuestra primera madre Eua la qual ahun que"},{"folioId":"5r","text":"no sintio las miserias dela niñez: empero no pudo fuyr la veiez."},{"folioId":"5r","text":"& pario fijos con dolor. ⅋ fue desterrada por su pena: & comio pan"},{"folioId":"5r","text":"con su trabajo. & filo lana. en fin por sus tiempos mundanalmen"},{"folioId":"5r","text":"te murio como las otras mujeres."},{"folioId":"6r","text":"Capitulo .ij. de semiramis: reyna delos assirios: la qul muerto su"},{"folioId":"6r","text":"marido Nino en lugar de su fijo / se vistio como hombre / & fizo & exercio muy"},{"folioId":"6r","text":"asperamente la arte militar / & del campo. & no solamente conseruo el reyno de su mari"},{"folioId":"6r","text":"do / mas ahun fizo el adarbe de Babilonia / & acrescento su reyno / fasta la india."},{"folioId":"8r","text":"Capitulo .iij. de opis: mujer de saturno. la qual fue di"},{"folioId":"8r","text":"cha madre delos dioses. esta como estviesse Roma en grand guerra con"},{"folioId":"8r","text":"tra los Cartagineses fue trahida de pesimonte cibdad del Asia: por cuyo"},{"folioId":"8r","text":"medio / & sacrificios: creyeron los romanos poder se saluar."},{"folioId":"9r","text":"Capitulo .iiij. de juno: hermana: & mujer del rey jupiter"},{"folioId":"9r","text":"de creta. la qual es dicha diosessa delas riquezas / & del matrimonio: & ayu"},{"folioId":"9r","text":"dadora delas primerizas / quando paren o estan preñadas. la qual prmero en"},{"folioId":"9r","text":"grecia: & luego despues en toda la asia: & finalmente en jtalia: & mayormen"},{"folioId":"9r","text":"te por los romanos gentiles: fue edificada."},{"folioId":"10r","text":"Capitulo .u. de ceres: fija de iupiter: & reyna delos sicili"},{"folioId":"10r","text":"anos. la qual se dize hauer fallado el trigo / & la labrança. ahun que dos"},{"folioId":"10r","text":"ceres se dize hauer sido. & ambas por egual hauer enseñado la agricultu"},{"folioId":"10r","text":"ra alos pueblos rudos / & saluajes. fue madre de proserpina: & suegra de"},{"folioId":"10r","text":"pluton tio suyo de padre."},{"folioId":"11v","text":"Capitulo .vj. de minerua: siquier pallas: que fue"},{"folioId":"11v","text":"dicha diosessa dela sabiduria: & inuentora delas artes: fija de Ju"},{"folioId":"11v","text":"piter: nascida de su celebro. ala qual pintan. & blasonan armada:"},{"folioId":"11v","text":"con un oliuo enla mano. las quales señales denotan enel sabio:"},{"folioId":"11v","text":"la paz: & la guerra: y enel tiempo delos gentiles: fue puesta enel nu"},{"folioId":"11v","text":"mero delos dioses."},{"folioId":"13r","text":"Capitulo .vij. de venus: fermosa diosessa. fija de Jupi"},{"folioId":"13r","text":"ter. la qual / o por su fermosura: tomo el nombre del planeta: o lo dio al"},{"folioId":"13r","text":"planeta. cuya ymagen / ha sido muy honrada / señaladamente en chipre."},{"folioId":"13r","text":"Empero en grecia: & en roma: fueron muchas ymagines suyas: ha"},{"folioId":"13r","text":"uidas en gran veneracion?"},{"folioId":"14v","text":"Capitulo .viij. de ysis: diosessa delos egyptianos. que"},{"folioId":"14v","text":"en su lenguaje: se llama luna. la qual fue fija de Inacho: rey delos argi"},{"folioId":"14v","text":"uos: siquier griegos: segun las fictiones: & fabulas delos poetas: muy"},{"folioId":"14v","text":"honrada / mayormente de Ouidio enel metamarphoseos. la qual passo"},{"folioId":"14v","text":"en egypto. & ende alos pueblos rudos & nescios / dio a entender muchas"},{"folioId":"14v","text":"cosas: en tanto: que fue hauida: & honrada por diosessa dellos / & su yma"}],"glosses":[],"dropInitials":[{"folioId":"1r","text":"J","letter":"J","depth":3},{"folioId":"2r","text":"E","letter":"E","depth":4},{"folioId":"3r","text":"E","letter":"E","depth":4},{"folioId":"6r","text":"S","letter":"S","depth":4},{"folioId":"8r","text":"O","letter":"O","depth":4},{"folioId":"9r","text":"I","letter":"I","depth":4},{"folioId":"11v","text":"M","letter":"M","depth":4},{"folioId":"13r","text":"A","letter":"A","depth":4},{"folioId":"15v","text":"A","letter":"A","depth":4},{"folioId":"17r","text":"L","letter":"L","depth":4},{"folioId":"17r","text":"M","letter":"M","depth":4},{"folioId":"18r","text":"T","letter":"T","depth":4},{"folioId":"21r","text":"N","letter":"N","depth":4},{"folioId":"23r","text":"M","letter":"M","depth":4},{"folioId":"24v","text":"A","letter":"A","depth":4},{"folioId":"25r","text":"O","letter":"O","depth":4},{"folioId":"25v","text":"E","letter":"E","depth":4},{"folioId":"26v","text":"M","letter":"M","depth":4},{"folioId":"27v","text":"A","letter":"A","depth":4},{"folioId":"29r","text":"D","letter":"D","depth":4},{"folioId":"30v","text":"A","letter":"A","depth":4},{"folioId":"31v","text":"N","letter":"N","depth":4},{"folioId":"33v","text":"P","letter":"P","depth":4},{"folioId":"34v","text":"A","letter":"A","depth":4},{"folioId":"35v","text":"M","letter":"M","depth":4},{"folioId":"36r","text":"E","letter":"E","depth":4},{"folioId":"38r","text":"P","letter":"P","depth":4},{"folioId":"38v","text":"P","letter":"P","depth":4},{"folioId":"39r","text":"H","letter":"H","depth":4},{"folioId":"41r","text":"C","letter":"C","depth":4},{"folioId":"41v","text":"H","letter":"H","depth":4},{"folioId":"43r","text":"C","letter":"C","depth":4},{"folioId":"44r","text":"C","letter":"C","depth":4},{"folio