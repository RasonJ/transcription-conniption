{"format":"hsms-facets/1","baseName":"TEXT.YD3","witnessHash":"1:ms_h81uxa","wordCount":2915,"typeCount":952,"ttr":0.3265866209262436,"sttr":0.4545,"hapax":620,"facets":{"rubrics":[{"folioId":"1r","text":"¶ Los dichos"},{"folioId":"1r","text":"o sentencias de los siete sabios"},{"folioId":"1r","text":"de Grecia, en metros"},{"folioId":"1r","text":"por el Bachiller"},{"folioId":"1r","text":"Hernan lopez de Yanguas."},{"folioId":"1r","text":"¶ Estos bocadillos de oro"},{"folioId":"1r","text":"me plugo escreuir en ternos"},{"folioId":"1r","text":"porque los niños mas tiernos."},{"folioId":"1r","text":"los puedan saber de coro."},{"folioId":"1v","text":"{SYMB: fleuron.} Prohemio..."},{"folioId":"3r","text":"¶ Comiençan los"},{"folioId":"3r","text":"dichos de Bias los quales son los"},{"folioId":"3r","text":"siguientes, y para ser bien entendi"},{"folioId":"3r","text":"dos, piense el lector que cada sabio"},{"folioId":"3r","text":"habla con el."},{"folioId":"5r","text":"¶ Aqui se acaban"},{"folioId":"5r","text":"los dichos de Bias, y comiençan"},{"folioId":"5r","text":"los de Periandro."},{"folioId":"8r","text":"¶ Aqui se acaban"},{"folioId":"8r","text":"los dichos de Periandro, y"},{"folioId":"8r","text":"comiençan los de pitaco."},{"folioId":"10r","text":"¶ Aqui se acaban"},{"folioId":"10r","text":"los dichos de Pitaco y comi"},{"folioId":"10r","text":"ençan los de Cleobulo."},{"folioId":"11v","text":"¶ Aqui se acaban"},{"folioId":"11v","text":"los dichos de Cleobulo, y comien"},{"folioId":"11v","text":"çan los de Chilon."},{"folioId":"13r","text":"¶ Aqui se acaban"},{"folioId":"13r","text":"los dichos de Chilon, y comien"},{"folioId":"13r","text":"çan los de Solon."},{"folioId":"14v","text":"¶ Aqui se acaban"},{"folioId":"14v","text":"los dichos de Solon, & siguen"},{"folioId":"14v","text":"se los de Thales."},{"folioId":"15v","text":"Fenescen los dichos delos siete sabi"},{"folioId":"15v","text":"os de grecia, interprete yanguas."},{"folioId":"15v","text":"Deo gracias."},{"folioId":"15v","text":"Fue impressa la"},{"folioId":"15v","text":"presente obra enla muy noble"},{"folioId":"15v","text":"villa de Medina del campo,"},{"folioId":"15v","text":"en casa de Pedro de castro"},{"folioId":"15v","text":"impressor de libros. Aca"},{"folioId":"15v","text":"bose a diez y seys de a"},{"folioId":"15v","text":"bril de .M.D.xliij."}],"glosses":[],"dropInitials":[],"codeSwitching":[{"lang":"LAT","words":2,"tokens":4,"spans":1}],"hands":[],"blockCounts":{"rubric":43,"prose":574},"tokenCounts":{"text":5643,"expansion":19,"figure_anchor":2,"hyphen":19,"editorial_insertion":11,"editorial_deletion":11,"blank_space":1}},"termFreq":{"que":160,"los":47,"por":33,"con":32,"mas":30,"tus":26,"las":25,"nunca":21,"bien":20,"siempre":18,"cosas":15,"porque":14,"ser":14,"dichos":12,"mal":12,"qual":12,"sin":12,"son":12,"ten":12,"como":11,"del":11,"muy":11,"aun":10,"tan":10,"delos":9,"dios":9,"mucho":9,"quien":9,"todos":9,"amigo":8,"hombre":8,"jamas":8,"para":8,"procura":8,"vida":8,"aqui":7,"buena":7,"este":7,"hazer":7,"mundo":7,"quando":7,"tal":7,"tengas":7,"acaban":6,"amigos":6,"comiencan":6,"cosa":6,"ellos":6,"esta":6,"guarda":6,"hecho":6,"nadie":6,"quieres":6,"saber":6,"sea":6,"seas":6,"senor":6,"sey":6,"tiempo":6,"todas":6,"todo":6,"virtud":6,"alguna":5,"alos":5,"biuir":5,"cumple":5,"cures":5,"digas":5,"mira":5,"muchos":5,"otro":5,"padres":5,"parte":5,"puedan":5,"sabe":5,"sino":5,"tienes":5,"bueno":4,"buenos":4,"casa":4,"dela":4,"delo":4,"deues":4,"digo":4,"enel":4,"entre":4,"estos":4,"fama":4,"gran":4,"grecia":4,"hablar":4,"has":4,"haz":4,"haze":4,"hechos":4,"honrra":4,"ley":4,"memoria":4,"muger":4,"ninguno":4,"noble":4,"quier":4,"rico":4,"sabio":4,"sabios":4,"sobre":4,"solo":4,"sus":4,"tiene":4,"tres":4,"aborresce":3,"algun":3,"bias":3,"bienes":3,"biue":3,"buen":3,"cada":3,"calla":3,"callar":3,"chilon":3,"cleobulo":3,"consejo":3,"dellos":3,"dezir":3,"donde":3,"enellos":3,"fin":3,"fortuna":3,"gana":3,"ganada":3,"hallo":3,"les":3,"malos":3,"mayor":3,"mej