{"format":"hsms-facets/1","baseName":"TEXT.AG7","witnessHash":"1:ms_46803q","wordCount":145442,"typeCount":7544,"ttr":0.051869473742110254,"sttr":0.39665517241379317,"hapax":3130,"facets":{"rubrics":[{"folioId":"3r","text":"¶ Comiença la coronica delos famosos caualle"},{"folioId":"3r","text":"ros Lisuarte de grecia y Perion de gaula hijos delos valientes y esforçados caualleros"},{"folioId":"3r","text":"Amadis de gaula rey dela gran Bretaña: & de Esplandian su hijo emperador de Co"},{"folioId":"3r","text":"stantinopla. Segun que la escriuio el gran sabio enlas magicas Alquife. Emendada"},{"folioId":"3r","text":"de algunos vocablos que corrompidos estauan por el antiguedad. La qual trata delas"},{"folioId":"3r","text":"grandes cauallerias que por estos dos grandissimos principes passaron segun que por"},{"folioId":"3r","text":"ella parescera. E fue dirigida al reuerendissimo & muy magnifico señor don Diego de"},{"folioId":"3r","text":"Deça Arçobispo de Seuilla."},{"folioId":"3r","text":"¶ Capitulo prmero de"},{"folioId":"3r","text":"como Perion de gaula y otros siete donze"},{"folioId":"3r","text":"les hijos de reyes partieron de londres pa"},{"folioId":"3r","text":"ra Yrlanda para ser armados caualleros"},{"folioId":"3r","text":"del rey Cildadan."},{"folioId":"4r","text":"¶ Capitulo segundo de"},{"folioId":"4r","text":"como Perion fue con la donzella Alqui"},{"folioId":"4r","text":"fa enla barca de los Ximios: & lo que le a"},{"folioId":"4r","text":"caescio."},{"folioId":"5v","text":"¶ Capitulo .iij. como"},{"folioId":"5v","text":"despues de armado cauallero perion vuo ba"},{"folioId":"5v","text":"talla con Alpatrasio duque de Orcalio: &"},{"folioId":"5v","text":"lo vencio."},{"folioId":"6v","text":"¶ Capitulo .iiij. de co"},{"folioId":"6v","text":"mo Lisuarte & Florestan & sus compañe"},{"folioId":"6v","text":"ros yendo por la mar a buscar a Perion en"},{"folioId":"6v","text":"tres naos repartidos: la naue en que yuan"},{"folioId":"6v","text":"Vallados y Quadragante aporto ala ysla"},{"folioId":"6v","text":"del gigante Argamonte & se combatieron"},{"folioId":"6v","text":"conel & lo vencieron."},{"folioId":"8r","text":"¶ Capitulo .u. de como"},{"folioId":"8r","text":"la donzella dela barca lleuo a Perion por"},{"folioId":"8r","text":"la mar al pie de vna peña & le dixo que subies"},{"folioId":"8r","text":"se alo alto & le atendiesse en vna fuente que"},{"folioId":"8r","text":"alli hallaria: & delo que alli le acontescio."},{"folioId":"10r","text":"¶ Capitulo .vj. de co"},{"folioId":"10r","text":"mo Lisuarte & Florestan & Parmineo yen"},{"folioId":"10r","text":"do por la mar en demanda de Perion: apor"},{"folioId":"10r","text":"taron en Tr a pisonda: & fueron a hazer re"},{"folioId":"10r","text":"uerencia al Emperador."},{"folioId":"12r","text":"¶ Capitulo .vij. de co"},{"folioId":"12r","text":"mo estando Lisuarte & sus compañeros conel"},{"folioId":"12r","text":"emperador: entro vna donzella & demando"},{"folioId":"12r","text":"vn don ala princesa Onoloria que Lisuar"},{"folioId":"12r","text":"te fuesse conella."},{"folioId":"12v","text":"¶ Capitulo .viij. de co"},{"folioId":"12v","text":"mo Florestan & sus compañeros se despidie"},{"folioId":"12v","text":"ron del emperador & la emperatriz & sus hi"},{"folioId":"12v","text":"jas para yr conel duque de Orlitensa ala"},{"folioId":"12v","text":"guerra. E como vn enano truxo vna carta"}],"glosses":[],"dropInitials":[{"folioId":"2r","text":"E","letter":"E","depth":10},{"folioId":"3r","text":"D","letter":"D","depth":8},{"folioId":"4r","text":"B","letter":"B","depth":4},{"folioId":"5v","text":"A","letter":"A","depth":4},{"folioId":"6v","text":"B","letter":"B","depth":4},{"folioId":"8r","text":"Y","letter":"Y","depth":4},{"folioId":"10r","text":"L","letter":"L","depth":4},{"folioId":"12r","text":"A","letter":"A","depth":4},{"folioId":"13r","text":"A","letter":"A","depth":4},{"folioId":"13r","text":"Y","letter":"Y","depth":4},{"folioId":"15v","text":"Y","letter":"Y","depth":4},{"folio