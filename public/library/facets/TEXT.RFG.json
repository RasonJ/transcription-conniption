dentemente en tus negocios."},{"folioId":"13r","text":"¶ Capitulo .x. Que en tus"},{"folioId":"13r","text":"cosas y buenas obras deues ser constante."},{"folioId":"14r","text":"¶ Capitulo .xj. Commo te"},{"folioId":"14r","text":"deues guardar de malos vicios."},{"folioId":"15v","text":"¶ Capitulo .xij. Y postrimero."},{"folioId":"15v","text":"Como te deues guardar de malos amigos."},{"folioId":"16r","text":"¶ Fin dela presente obra."}],"glosses":[],"dropInitials":[{"folioId":"1v","text":"F","letter":"F","depth":5},{"folioId":"2r","text":"L","letter":"L","depth":5},{"folioId":"3r","text":"E","letter":"E","depth":2},{"folioId":"4r","text":"D","letter":"D","depth":2},{"folioId":"5r","text":"A","letter":"A","depth":2},{"folioId":"6v","text":"A","letter":"A","depth":2},{"folioId":"7v","text":"N","letter":"N","depth":2},{"folioId":"9r","text":"S","letter":"S","depth":2},{"folioId":"10v","text":"E","letter":"E","depth":2},{"folioId":"11v","text":"D","letter":"D","depth":2},{"folioId":"13r","text":"E","letter":"E","depth":2},{"folioId":"14r","text":"N","letter":"N","depth":2},{"folioId":"15v","text":"S","letter":"S","depth":2}],"codeSwitching":[],"hands":[],"blockCounts":{"prose":1013,"rubric":37},"tokenCounts":{"figure_anchor":1,"text":20734,"hyphen":195,"expansion":600,"drop_initial":13,"editorial_deletion":20,"editorial_insertion":16,"superscript":13,"blank_space":16}},"termFreq":{"que":609,"por":158,"mas":79,"los":75,"con":73,"bien":69,"dize":64,"mal":62,"porque":62,"quien":62,"las":52,"assi":46,"hijo":46,"mucho":44,"como":43,"del":42,"para":41,"deues":39,"muger":38,"pues":37,"hazer":34,"esso":32,"refran":32,"mio":31,"dios":29,"sea":29,"buena":28,"dela":28,"ala":27,"esto":27,"tal":24,"tus":24,"casa":23,"dixo":23,"buen":22,"dar":22,"dizen":22,"son":22,"asno":21,"puede":21,"dezir":20,"hombre":20,"tiene":20,"todo":20,"alguna":19,"gran":19,"ser":19,"aquel":18,"cierto":18,"enel":18,"otro":18,"algun":17,"avn":17,"enla":17,"mala":17,"prouerbio":17,"quando":17,"tanto":17,"alos"