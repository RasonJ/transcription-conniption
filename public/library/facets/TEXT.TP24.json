{"format":"hsms-facets/1","baseName":"TEXT.TP24","witnessHash":"1:ms_9191br","wordCount":38910,"typeCount":3944,"ttr":0.1013621177075302,"sttr":0.34871052631578947,"hapax":1911,"facets":{"rubrics":[{"folioId":"1r","text":"Thesoro delos pobres."},{"folioId":"2v","text":"¶ Aqui se acaba la tabla."},{"folioId":"2v","text":"Y comiença la presente obra."},{"folioId":"3r","text":"¶ Aqui comiença un libro muy provechoso en medi"},{"folioId":"3r","text":"cina llamado Tesoro delos pobres. El qual mando hazer el papa Juan a un medico"},{"folioId":"3r","text":"suyo llama d o maestre Juliano hombre muy sabio y experimentado en medicina. El"},{"folioId":"3r","text":"qual por servir a su santidad: & por servicio de dios y por bien delos pr o ximos busco"},{"folioId":"3r","text":"quantos Doctores y Maestros hauia en medicina en aquel tiempo: en que ouo. lvj."},{"folioId":"3r","text":"Doctores: que allego para esta obra: muy sabios. Para que los hombres se sepan curar"},{"folioId":"3r","text":"sin medico;donde no lo obiere & obiere mucha necessidad."},{"folioId":"3r","text":"Capitulo primero para las"},{"folioId":"3r","text":"postillas guarescer o ala sarna."},{"folioId":"3v","text":"¶ Capitulo. ij. Como haras que no"},{"folioId":"3v","text":"nazcan piojos ni liendres."},{"folioId":"4r","text":"¶ Capitulo. iij. para despertar"},{"folioId":"4r","text":"los que duermen mucho."},{"folioId":"4r","text":"¶ Capitulo. iij. para sanar el freneti"},{"folioId":"4r","text":"co que quiere dezir hombre desme"},{"folioId":"4r","text":"moriado por mengua de dormir"},{"folioId":"4v","text":"¶ Capitulo. u. Como sana"},{"folioId":"4v","text":"ras el dolor dela cabeça."},{"folioId":"5r","text":"¶ Capitulo. vj. Como sana"},{"folioId":"5r","text":"ras el dolor delas sienes."},{"folioId":"5v","text":"¶ Capitulo. vij. De como sanaras el"},{"folioId":"5v","text":"dolor dela frente y delos ojos."},{"folioId":"5v","text":"¶ Capitulo. viij. Como sanaras el que"},{"folioId":"5v","text":"no puede dormir por el dolor dela"},{"folioId":"5v","text":"cabeça & de otro lugar qualquier."},{"folioId":"6r","text":"¶ Capitulo. ix. Como sanaras"},{"folioId":"6r","text":"las enfermedades delos ojos."},{"folioId":"7v","text":"¶ Capitulo. x. Como sanaras"},{"folioId":"7v","text":"el dolor delas orejas"},{"folioId":"8v","text":"¶ Capitulo xi. Para sanar la rosa de"},{"folioId":"8v","text":"la cara o el empeyne o otra manzilla."},{"folioId":"8v","text":"¶ Capitulo. xij. Para guarescer hombre que"},{"folioId":"8v","text":"tiene dolor delos dientes o delas enzias."},{"folioId":"9v","text":"¶ Capitulo. xiii. para estancar la sangre delas"},{"folioId":"9v","text":"narizes o de otro legar qualquier que sea"},{"folioId":"10r","text":"¶ Capitulo. xiiij. para sanar el que pierde la ha"},{"folioId":"10r","text":"bla por hinchazon o por humores frios."},{"folioId":"10r","text":"¶ Capitulo xv. para guarescer"},{"folioId":"10r","text":"el mamillo"},{"folioId":"10v","text":"¶ Capitulo. xvi. para sanar los epelenticos"},{"folioId":"10v","text":"que son menguados de meollo y engendran"},{"folioId":"10v","text":"fantasia & son gotosos & caen en tierra."},{"folioId":"11v","text":"¶ Capitulo. xvij. para sanar la"},{"folioId":"11v","text":"postema que nasce en la garganta."},{"folioId":"11v","text":"¶ Capitulo. xviij. para la fleuma que deciende"}],"glosses":[],"dropInitials":[{"folioId":"3r","text":"E","letter":"E","depth":6},{"folioId":"3r","text":"S","letter":"S","depth":4},{"folioId":"4r","text":"S","letter":"S","depth":4},{"folioId":"26v","text":"T","letter":"T","depth":4},{"folioId":"3v","text":"E","letter":"E","depth":3},{"folioId":"4r","text":"S","letter":"S","depth":3},{"folioId":"4v","text":"P","letter":"P","depth":3},{"folioId":"5r","text":"D","letter":"D","depth":3},{"folioId":"5v","text":"P","letter":"P","depth":3},{"folioId":"5v","text":"D","letter":"D","depth":3},{"folioId":"6r","text":"P","letter":"P","depth":3},{"folioId":"7v","text":"P","letter":"P","depth":3},{"folioId":"8v","text":"D",