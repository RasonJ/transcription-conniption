{"format":"hsms-facets/1","baseName":"TEXT.NA9","witnessHash":"1:ms_1886mzz","wordCount":12499,"typeCount":2116,"ttr":0.16929354348347866,"sttr":0.35216666666666674,"hapax":1223,"facets":{"rubrics":[{"folioId":"1r","text":"AVISO DE CA"},{"folioId":"1r","text":"çadores, y Caça."},{"folioId":"1r","text":"Ordenado por el Doctor Pedro Nuñez de Auenda"},{"folioId":"1r","text":"ño: Letrado de don Yñigo Lopez de Mendoça"},{"folioId":"1r","text":"Tercero deste nombre, Duque"},{"folioId":"1r","text":"del Infantado."},{"folioId":"1r","text":"Con nueuas Adiciones."},{"folioId":"1r","text":"[]"},{"folioId":"1r","text":"CON PRIVILEGIO."},{"folioId":"1r","text":"EN MADRID,"},{"folioId":"1r","text":"En casa de Pedro Madrigal,"},{"folioId":"1r","text":"Año. de 1593."},{"folioId":"2r","text":"A DON IÑIGO LOPEZ DE"},{"folioId":"2r","text":"Mendoça, Duque del Infantado, Marques de SAN"},{"folioId":"2r","text":"tillana, Conde de Saldaña, y del Real de"},{"folioId":"2r","text":"Mançanares, &c. El Doctor Pedro"},{"folioId":"2r","text":"Nuñez de Auendaño, per"},{"folioId":"2r","text":"petua felicidad."},{"folioId":"2r","text":"Prologo"},{"folioId":"3r","text":"COMPENDIO Y RE"},{"folioId":"3r","text":"SOLVCION, EN QVE SE"},{"folioId":"3r","text":"escriue, como se puede licitamente"},{"folioId":"3r","text":"vsar la caça."},{"folioId":"6r","text":".PRIMERA DVDA."},{"folioId":"6v","text":"SEGVNDA DVDA"},{"folioId":"6v","text":"TERCERA DVDA"},{"folioId":"7r","text":"Para determinacion desta duda, se ha de di"},{"folioId":"7r","text":"stinguir tres casos."},{"folioId":"7v","text":"QVARTA DVDA."},{"folioId":"7v","text":"Para determinacion de lo qual se han de di"},{"folioId":"7v","text":"stinguir los casos siguientes."},{"folioId":"8r","text":"QVINTA DUDA"},{"folioId":"8r","text":"A esta duda se responde, con distincion de"},{"folioId":"8r","text":"los casos siguientes"},{"folioId":"9r","text":"SEXTA DVDA"},{"folioId":"9r","text":"Y para determinacion desta question, que es"},{"folioId":"9r","text":"muy necessaria y contingible, han de ser"},{"folioId":"9r","text":"considerados, y distinguidos los"},{"folioId":"9r","text":"casos siguientes."},{"folioId":"11v","text":"SEPTIMA DVDA"},{"folioId":"11v","text":"A esta duda se satisfaze, presuponiendo pri"},{"folioId":"11v","text":"meramente que cosa sea daño."},{"folioId":"12v","text":"OCTAVA DVDA"},{"folioId":"13r","text":"NONA DVDA"},{"folioId":"13r","text":"A esta duda se responde, haziendo distin"},{"folioId":"13r","text":"cion entre las personas ecclesiasticas"},{"folioId":"13r","text":"y seglares, en esta manera."},{"folioId":"13v","text":"Quanto a los legos, para se dezir la caça licita"}],"glosses":[],"dropInitials":[{"folioId":"2r","text":"L","letter":"L","depth":6},{"folioId":"3r","text":"P","letter":"P","depth":7},{"folioId":"6r","text":"S","letter":"S","depth":2},{"folioId":"6v","text":"S","letter":"S","depth":2},{"folioId":"6v","text":"S","letter":"S","depth":2},{"folioId":"7r","text":"E","letter":"E","depth":2},{"folioId":"7v","text":"S","letter":"S","depth":2},{"folioId":"7v","text":"E","letter":"E","depth":2},{"folioId":"8r","text":"S","letter":"S","depth":2},{"folioId":"8r","text":"E","letter":"E","depth":2},{"folioId":"9r","text":"S","letter":"S","depth":2},{"folioId":"9r","text":"E","letter":"E","depth":2},{"folioId":"11v","text":"E","letter":"E","depth":2},{"folioId":"11v","text":"Y","letter":"Y","depth":2},{"folioId":"12v","text":"S","letter":"S","depth":2},{"folioId":"13r","text":"S","letter":"S","depth":2},{"folioId":"13r","text":"L","letter":"L","depth":2},{"folioId":"13v","text":"L","letter":"L","depth":2},{"folioId":"15v","text":"E","letter":"E","depth":2},{"folioId":"15v","text":"P","letter":"P","depth":2},{"folioId":"16r","text":"S","letter":"S","depth":2},{"folioId":"16r","text":"E","letter":"E","depth":2},{"folioId":"16r","text":"S","letter":"S","depth":2},{"folioId":"16r","text":"A","letter":"A","depth":2},{"folioId":"16v","text":"S","letter":"S","depth":2},{"folioId":"17r","text"