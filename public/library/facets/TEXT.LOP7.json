{"format":"hsms-facets/1","baseName":"TEXT.LOP7","witnessHash":"1:ms_fmxqmo","wordCount":83185,"typeCount":5123,"ttr":0.06158562240788604,"sttr":0.3229759036144579,"hapax":2426,"facets":{"rubrics":[{"folioId":"1v","text":"¶ TABLA DE LOS TITVLOS ¶"},{"folioId":"1v","text":"de la Setena partida."},{"folioId":"2r","text":"Aqui Comiença la sete"},{"folioId":"2r","text":"na partida deste nuestro libro, que"},{"folioId":"2r","text":"fabla de todas las acusaciones,"},{"folioId":"2r","text":"e maleficios que los omes"},{"folioId":"2r","text":"fazen, e que pena me"},{"folioId":"2r","text":"rescen auer po"},{"folioId":"2r","text":"r ende."},{"folioId":"2r","text":"Titulo primero de las"},{"folioId":"2r","text":"acusaciones que se fazen contra los ma"},{"folioId":"2r","text":"los fechos, e de los denunciamientos, e"},{"folioId":"2r","text":"del oficio del judgador que ha a pesque"},{"folioId":"2r","text":"rir los malos fechos."},{"folioId":"2v","text":"¶ Ley .I. Que cosa es acusacion, e a que tiene pro, e"},{"folioId":"2v","text":"quantas maneras son della."},{"folioId":"2v","text":"¶ Ley .II. quien puede acusar a quien."},{"folioId":"3v","text":"¶ Ley .III. Como aquel que es sieruo non puede"},{"folioId":"3v","text":"acusar a otro."},{"folioId":"3v","text":"¶ Ley .IIII. Como aquel que es accusado non"},{"folioId":"3v","text":"puede acusar a otri fasta que sea librado"},{"folioId":"3v","text":"por juyzio de la acusacion que le es fecha."},{"folioId":"4r","text":"¶ Ley .V. Como los merinos e los otros oficiales"},{"folioId":"4r","text":"pueden apercebir al Rey de los yerros que fa"},{"folioId":"4r","text":"zen en los lugares do biuen."},{"folioId":"4v","text":"¶ Ley .VI. Como non puede ninguno ome acusar"},{"folioId":"4v","text":"a otro por personero."},{"folioId":"4v","text":"¶ Ley .VII. Contra quien puede ser fecha acusacion."},{"folioId":"5r","text":"¶ Ley .VIII. Por quales yerros que el oficial faze"},{"folioId":"5r","text":"puede ser acusado."},{"folioId":"5r","text":"¶ Ley .IX. Por quales yerros pueden ser acusados"},{"folioId":"5r","text":"los menores e por quales non."},{"folioId":"5v","text":"¶ Ley .X. Por quales razones puede ser acusado"},{"folioId":"5v","text":"el sieruo."},{"folioId":"6r","text":"¶ Ley .XI. De quales yerros pueden ser acusados"},{"folioId":"6r","text":"los officiales del Rey, mientra estvieren en sus"},{"folioId":"6r","text":"officios, e de quales non."},{"folioId":"6r","text":"¶ Ley .XII. Como aquel que es quito una vez"},{"folioId":"6r","text":"por juyzio acabado del yerro que fizo, non lo pue"},{"folioId":"6r","text":"den acusar despues,"},{"folioId":"6v","text":"¶ Ley .XIII. Como quando muchos quieren acu"},{"folioId":"6v","text":"sar a uno de algun yerro, el juez deue escoger el"},{"folioId":"6v","text":"uno dellos que faga la acusacion."},{"folioId":"7r","text":"¶ Ley .XIIII. Como deue ser fecha la acusacion."},{"folioId":"7v","text":"¶ Ley .XV. Ante qual juez puede o deue ser. ⇒"},{"folioId":"7v","text":"fecha la acusacion."},{"folioId":"8r","text":"¶ Ley .XVI. En que manera deue el acusado re"},{"folioId":"8r","text":"sponder a la acusacion que fazen contra el."}],"glosses":[],"dropInitials":[{"folioId":"1v","text":"T","letter":"T","depth":5},{"folioId":"2r","text":"O","letter":"O","depth":5},{"folioId":"2r","text":"A","letter":"A","depth":5},{"folioId":"15r","text":"T","letter":"T","depth":5},{"folioId":"18v","text":"R","letter":"R","depth":5},{"folioId":"21r","text":"L","letter":"L","depth":5},{"folioId":"22v","text":"D","letter":"D","depth":5},{"folioId":"25v","text":"V","letter":"V","depth":5},{"folioId":"28v","text":"O","letter":"O","depth":5},{"folioId":"32v","text":"D","letter":"D","depth":5},{"folioId":"38v","text":"S","letter":"S","depth":5},{"folioId":"43v","text":"D","letter":"D","depth":5},{"folioId":"44r","text":"T","letter":"T","depth":5},{"folioId":"45v","text":"R","letter":"R","depth":5},{"folioId":"46v","text":"F","letter":"F","depth":5},{"folioId":"63r","text":"E","letter":"E","depth