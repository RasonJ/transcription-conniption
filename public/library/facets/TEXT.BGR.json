{"format":"hsms-facets/1","baseName":"TEXT.BGR","witnessHash":"1:ms_tfvkw0","wordCount":152588,"typeCount":9561,"ttr":0.06265892468608278,"sttr":0.41705921052631567,"hapax":4732,"facets":{"rubrics":[{"folioId":"2r","text":"[] Prologo dirigido al Yllustre y Reuerendissimo []"},{"folioId":"2r","text":"Señor don Pero xuarez de Figueroa y de Velasco:"},{"folioId":"2r","text":"Dean de Burgos y Abad de Hermedes y Arcediano"},{"folioId":"2r","text":"de Valpuesta: señor de la Villa de Cozcurrita &cetera."},{"folioId":"3r","text":"[] Comiença la Hystoria del magnanimo []"},{"folioId":"3r","text":"valiente & inuencible cauallero don Belianis de Grecia hijo del Empera"},{"folioId":"3r","text":"dor don Belanio de Grecia. En el qual se cuentan las notables y valientes"},{"folioId":"3r","text":"auenturas que acabo con los amores que tvo con la Princesa Florisbe"},{"folioId":"3r","text":"lla hija del Soldan de Babilonia: y como fue hallada y descubierta"},{"folioId":"3r","text":"la infanta Policena hija del Rey Priamo de Troya. Tra"},{"folioId":"3r","text":"duzida de lengua griega en vulgar Castellano."},{"folioId":"3r","text":"¶ Capitulo .j. Como"},{"folioId":"3r","text":"el emperador don Belanio fue casado"},{"folioId":"3r","text":"con la princesa Clarinda hija del Rey"},{"folioId":"3r","text":"Toloyano de españa."},{"folioId":"3v","text":"¶ Capitulo .ij. De como"},{"folioId":"3v","text":"nacio el principe don Belianis de grecia"},{"folioId":"3v","text":"y de vna estraña auentura que le acaescio"},{"folioId":"3v","text":"andando a caça por donde se partio de"},{"folioId":"3v","text":"su padre."},{"folioId":"5v","text":"¶ Capitulo .iij. Como el em"},{"folioId":"5v","text":"perador se partio en busca de los principes."},{"folioId":"6r","text":"¶ Capitulo .iiij. Dela extra"},{"folioId":"6r","text":"ña y peligrosa auentura que al emperador"},{"folioId":"6r","text":"acaescio en busca del principe don Belia"},{"folioId":"6r","text":"nis enel castillo encubierto."},{"folioId":"8r","tex